# Dependencies
node_modules

# Build output
dist
coverage

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
**/*.swp
**/*.swo
**/*~

# Environment files
#
# `.env*`, not the four exact names it replaces: `.env` matches only the literal
# file and `.env.*.local` needs the `.local` suffix, so a `.env.production` or
# `.env.staging` would have slipped into the builder layer through `COPY . .`.
# Nothing in any image reads an env file — docker-entrypoint.sh doesn't either.
.env*

# Test files
#
# `**/`, because a bare `*.spec.ts` is matched against the whole context-relative
# path and `*` does not cross `/` — it caught nothing, while all 276 spec files
# live under src/ and rode into the builder layer. They never reached `dist`
# regardless: tsconfig.build.json excludes `**/*spec.ts`.
# The e2e specs and jest-e2e.json are under test/, already covered by the line below.
test
**/*.spec.ts

# Documentation
README.md
docs

# ROOT-LEVEL ONLY — do not turn this into `**/*.md`.
#
# It is meant to drop README.md, nothing more. The RAG help corpus is 31 .md
# files under src/modules/rag/retrieval/corpus/, and they reach `dist` through a
# nest-cli asset rule rather than through tsc — so a `**/` here would strip the
# assistant's entire knowledge base without failing the TypeScript build.
# The assertion at Dockerfile:177 is what catches it; keep the pattern anchored
# and that assertion never has to fire.
*.md

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Local tooling — never read by any stage. `docker/init-db.sh` is mounted from
# the host by docker-compose, not copied by the build; the Dockerfile is read by
# BuildKit itself rather than through the context.
Dockerfile
docker-compose.yml
docker-compose.prod.yml
docker
.prettierrc
eslint.config.mjs

# OS
# `**/`: .DS_Store regenerates in subdirectories, not just at the root.
**/.DS_Store
**/Thumbs.db

# Logs
logs
**/*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.cache
.temp
**/*.tmp

# The developer-side FastEmbed cache — 2.7GB of ONNX weights. Gitignored, but
# .dockerignore is what keeps it out of the build context, and `COPY . .` in the
# builder stage would otherwise bake it into a layer.
local_cache
