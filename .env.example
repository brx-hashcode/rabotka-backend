# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
DATABASE_URL=

# Health Check Configuration (optional)
HEALTH_DISK_CHECK_ENABLED=true
HEALTH_DISK_THRESHOLD_PERCENT=0.98

# CORS - comma-separated allowed origins
ALLOW_ORIGINS=http://localhost:3000

# Rate limiter (optional)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Number of ADMIN users to seed
SEED_USER_COUNT=10

# CSRF Protection - generate with: openssl rand -base64 32
CSRF_SECRET=your-32-byte-minimum-random-secret


# Arcjet (get key from https://app.arcjet.com)
ARCJET_KEY=
# Optional: set to development for dev
# ARCJET_ENV=development

# Mail / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_MOCK=false
# Optional: full URL to welcome email banner image (e.g. hosted on CDN or app static)
# MAIL_BANNER_URL=

# Redis (queue) – host connects to Docker-published port
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=
RUN_QUEUE_WORKER=false

# Twilio (WhatsApp and optional SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# TWILIO_SMS_FROM=  # Optional, for SMS
# TWILIO_WEBHOOK_BASE_URL=  # Optional. When behind ngrok/tunnel, set to the public URL (e.g. https://xxx.ngrok.io) so signature validation uses the URL Twilio called.

# Frontend URL for verification links
FRONTEND_URL=http://localhost:3000

# Storage Driver: S3, CLOUDINARY, VERCEL_BLOB, CLOUDFLARE
DRIVER=S3

# S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_ENDPOINT_URL=  # For LocalStack

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob Configuration
BLOB_READ_WRITE_TOKEN=

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=

# Image watermark (applied to all uploaded images before storage)
# Path to Rabotka logo (absolute or relative to project root). Default: assets/rabotka-logo.png
WATERMARK_LOGO_PATH=assets/rabotka-logo.png
# Logo opacity 0-1 (default 0.3)
WATERMARK_OPACITY=0.3

# Vector search (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Google Service Account (for Google Docs API — document template filling)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: folder ID (…/folders/FOLDER_ID) for temporary Google Doc copies during fill/export PDF.
# Only used when a document is stored as Google Docs (source_mode GOOGLE_DOCS). Upload/DOCX templates do not use Drive or this variable.
# Use a Shared Drive folder so copies use pooled org storage. Grant the service account Content manager+ on that drive.
# GOOGLE_DOCS_TEMP_COPY_PARENT_FOLDER_ID=

