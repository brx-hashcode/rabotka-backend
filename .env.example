# Server Configuration
PORT=8000
NODE_ENV=development
# Set to true only in the production Vault secret to isolate Redis/BullMQ/Qdrant namespaces
IS_PROD=false

# ── Database ───────────────────────────────────────────────────────────────────
# Runtime connection.
# When routing through PgBouncer (production), append ?pgbouncer=true:
#   DATABASE_URL=postgresql://rabotka:<pwd>@pgbouncer:5432/rabotka?pgbouncer=true
# For migrations bypassing PgBouncer, override at the CLI:
#   DATABASE_URL=$DATABASE_DIRECT_URL pnpm prisma migrate deploy
DATABASE_URL=
# Direct connection for migrations (bypasses PgBouncer transaction mode).
# Optional — falls back to DATABASE_URL for local dev without PgBouncer.
DATABASE_DIRECT_URL=

# Health Check Configuration (optional)
HEALTH_DISK_CHECK_ENABLED=true
HEALTH_DISK_THRESHOLD_PERCENT=0.98

# CORS - comma-separated allowed origins
ALLOW_ORIGINS=http://localhost:3000

# Rate limiter (optional)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Number of ADMIN users to seed
SEED_USER_COUNT=10

# CSRF Protection - generate with: openssl rand -base64 32
CSRF_SECRET=your-32-byte-minimum-random-secret


# Arcjet (get key from https://app.arcjet.com)
ARCJET_KEY=
# Optional: set to development for dev
# ARCJET_ENV=development

# Mail / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_MOCK=false
# Optional: full URL to welcome email banner image (e.g. hosted on CDN or app static)
# MAIL_BANNER_URL=

# ── Mailcow (production) ───────────────────────────────────────────────────────
# After Mailcow is running on mail.hashcode.digital, replace the SMTP_* values above:
# SMTP_HOST=mail.hashcode.digital
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@rabotka.work
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@rabotka.work
# SMTP_FROM_NAME=Rabotka
# SMTP_MOCK=false

# ── Redis ──────────────────────────────────────────────────────────────────────
# General cache + state.
# Production (shared host, DB 4): redis://rabotka:<pwd>@host.docker.internal:6379/4
# Local dev: leave REDIS_URL blank and set REDIS_HOST/REDIS_PORT instead.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# BullMQ queues.
# Production (shared host, DB 5): redis://rabotka:<pwd>@host.docker.internal:6379/5
# Leave blank locally — QueueService falls back to the REDIS_CONNECTION.
REDIS_QUEUE_URL=

RUN_QUEUE_WORKER=false

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Which backend actually sends. Switching providers is this variable plus a
# restart, and rollback is the same. Validated at boot: the selected provider's
# variables are required, the other's are not — but keep BOTH sets populated in
# staging and production, because rollback depends on it.
# See docs/whatsapp-providers.md.
#
# twilio | cloud
WHATSAPP_PROVIDER=twilio

# Twilio (WhatsApp, and optional SMS which shares the same account)
# Required when WHATSAPP_PROVIDER=twilio. These used to be settable from the
# admin settings page; they are environment-only now.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# TWILIO_SMS_FROM=  # Optional, for SMS
# TWILIO_WEBHOOK_BASE_URL=  # Optional. When behind ngrok/tunnel, set to the public URL (e.g. https://xxx.ngrok.io) so signature validation uses the URL Twilio called.

# Meta WhatsApp Cloud API
# Required when WHATSAPP_PROVIDER=cloud.
WHATSAPP_CLOUD_API_VERSION=v25.0
# Meta app -> WhatsApp -> API Setup
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# System user token. The one shown on the API Setup page is temporary (24h).
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Meta app -> Settings -> Basic -> App Secret. Verifies X-Hub-Signature-256.
WHATSAPP_CLOUD_APP_SECRET=
# Any string you choose; must match what you type into the Meta dashboard.
WHATSAPP_CLOUD_VERIFY_TOKEN=
# Meta app -> WhatsApp -> API Setup, or Business Settings -> WhatsApp Accounts.
WHATSAPP_CLOUD_WABA_ID=
# Meta app -> Paramètres de l'app -> Général. Needed only to upload template
# media, which runs against the app rather than the WABA.
WHATSAPP_CLOUD_APP_ID=
# Published feedback Flow. Create one with
# scripts/whatsapp-flows/create-feedback-flow.ts --commit
# Unset, feedback falls back to a link to the web form.
WHATSAPP_FEEDBACK_FLOW_ID=
# Public base for the WhatsApp card cover ONLY. Separate from
# CLOUDFLARE_PUBLIC_BASE_URL on purpose: that one serves user files from the
# storage bucket, while the cover lives in the bucket the approved cards point
# at. Leave unset unless the cover moves — the built-in default is correct.
WHATSAPP_MEDIA_BASE_URL=

# Frontend URL for verification links
FRONTEND_URL=http://localhost:3000

# Public base URL of this backend (no trailing slash).
# Used to build absolute asset URLs in emails (e.g. the logo image).
# Production example: https://api.rabotka.work
BACKEND_URL=http://localhost:8000

# Storage Driver: S3, CLOUDINARY, VERCEL_BLOB, CLOUDFLARE
DRIVER=S3

# S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_ENDPOINT_URL=  # For LocalStack

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob Configuration
BLOB_READ_WRITE_TOKEN=

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
# A SECOND bucket, which must never be made public. It holds only KYC files —
# identity documents and the selfies held next to them — served through signed
# urls that expire after an hour.
#
# It exists because R2 has no per-object ACL: a bucket is public or private as
# a whole. Avatars, chat and claim images legitimately need durable public
# urls, so the bucket above stays public and identity documents move out of it.
#
# Like every other storage setting, the deployed value comes from
# `storage.cloudflare.kyc_bucket_name` in admin › configuration système; this
# line is for local development. If neither is set, KYC uploads FAIL rather
# than falling back to the public bucket.
CLOUDFLARE_KYC_BUCKET_NAME=
# Public bucket/custom domain URL used for non-expiring public image links
CLOUDFLARE_PUBLIC_BASE_URL=

# Image watermark (applied to all uploaded images before storage)
# Path to Rabotka logo (absolute or relative to project root). Default: assets/rabotka-logo.png
WATERMARK_LOGO_PATH=assets/rabotka-logo.png
# Logo opacity 0-1 (default 0.3)
WATERMARK_OPACITY=0.3

# ── Vector search (Qdrant) ─────────────────────────────────────────────────────
# Production (shared host): http://host.docker.internal:6333
# Local dev: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Web session token (the one inside the cookie). Keep in step with
# AUTH_COOKIE_MAX_AGE_DAYS below: a shorter token means the browser keeps
# sending a session the server already refuses, with no way to refresh it.
JWT_EXPIRES_IN=30d
# Defaults to 30 when unset. Move it and JWT_EXPIRES_IN together.
# AUTH_COOKIE_MAX_AGE_DAYS=30
# Mobile token TTLs (bearer flow): short-lived access + longer-lived refresh
# Mobile access token is long-lived (no client refresh flow); logout still revokes via blocklist.
JWT_ACCESS_EXPIRES_IN=3650d
JWT_REFRESH_EXPIRES_IN=24h

PDF_OWNER_PASSWORD=password

# ── Vova AI (assistant) ────────────────────────────────────────────────────────
# Provider credentials. A tier silently drops any provider whose key is blank —
# the resolved chain per tier is logged once at boot, so check that line rather
# than guessing which model answered.
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Model ids, overridable because vendors rename and retire them on their own
# schedule. The Google defaults are `-latest` aliases on purpose: a pinned id
# was retired mid-project and answered 404. Pin one here if a model change ever
# regresses the evals.
# VOVA_MODEL_CHEAP_GOOGLE=gemini-flash-lite-latest
# VOVA_MODEL_STANDARD_GOOGLE=gemini-flash-latest
# VOVA_MODEL_STANDARD_MISTRAL=mistral-small-latest
# Groq is the exception to the alias rule above: it publishes none, so this id
# is pinned and WILL eventually be retired. Override it here when that happens.
# VOVA_MODEL_STANDARD_GROQ=llama-3.3-70b-versatile
# VOVA_MODEL_STANDARD_DEEPSEEK=deepseek-chat
# VOVA_MODEL_STANDARD_OPENAI=gpt-4o-mini

# Per-attempt budget, per provider. Measured, not guessed: a tool-calling turn
# with the system prompt and tool schemas takes well over 8s on a cold call, and
# 8000 here made every agent turn time out and fall through to a refusal.
# VOVA_LLM_TIMEOUT_MS=20000
# VOVA_LLM_RETRY_BACKOFF_MS=250
# VOVA_TEMPERATURE=0.2

# Circuit breaker: consecutive failures before a provider is skipped, how long
# it stays skipped, and how long a failure counts toward the threshold.
# VOVA_BREAKER_THRESHOLD=5
# VOVA_BREAKER_COOLDOWN_S=60
# VOVA_BREAKER_WINDOW_S=120

# How long the assistant caches the job-category list. Categories are mutable at
# runtime (admins create and delete them), so this is a staleness budget, not a
# constant — an admin's new domain becomes searchable within one TTL.
# VOVA_CATEGORY_TTL_MS=300000

# How many corpus chunks a help lookup returns.
# VOVA_RETRIEVAL_LIMIT=5

# Below this retrieval score a question is logged as `vova.gap` — a question the
# corpus could not answer. Those lines are the input to the next article; they
# are NOT fed back automatically (see src/modules/rag/docs/PROJECT_CONTEXT.md).
# VOVA_GAP_SCORE=0.55
