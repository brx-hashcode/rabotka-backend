# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL) - used when NODE_ENV !== 'test'
# When NODE_ENV=test, SQLite in-memory is used automatically
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=rabotka

# CORS - comma-separated allowed origins
ALLOW_ORIGINS=http://localhost:3000

# Rate limiter (optional)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Number of ADMIN users to seed
SEED_USER_COUNT=10
