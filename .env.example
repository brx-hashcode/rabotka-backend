# Server Configuration
PORT=8000
NODE_ENV=development
# Set to true only in the production Vault secret to isolate Redis/BullMQ/Qdrant namespaces
IS_PROD=false

# ── Database ───────────────────────────────────────────────────────────────────
# Runtime connection.
# When routing through PgBouncer (production), append ?pgbouncer=true:
#   DATABASE_URL=postgresql://rabotka:<pwd>@pgbouncer:5432/rabotka?pgbouncer=true
# For migrations bypassing PgBouncer, override at the CLI:
#   DATABASE_URL=$DATABASE_DIRECT_URL pnpm prisma migrate deploy
DATABASE_URL=
# Direct connection for migrations (bypasses PgBouncer transaction mode).
# Optional — falls back to DATABASE_URL for local dev without PgBouncer.
DATABASE_DIRECT_URL=

# Health Check Configuration (optional)
HEALTH_DISK_CHECK_ENABLED=true
HEALTH_DISK_THRESHOLD_PERCENT=0.98

# CORS - comma-separated allowed origins
ALLOW_ORIGINS=http://localhost:3000

# Rate limiter (optional)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Number of ADMIN users to seed
SEED_USER_COUNT=10

# CSRF Protection - generate with: openssl rand -base64 32
# Required, at least 32 characters: the API refuses to start without it. Left
# blank here on purpose, so a copied example cannot boot with a guessable key.
CSRF_SECRET=


# Arcjet (get key from https://app.arcjet.com)
ARCJET_KEY=
# Optional: set to development for dev
# ARCJET_ENV=development

# Mail / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_MOCK=false
# Optional: full URL to welcome email banner image (e.g. hosted on CDN or app static)
# MAIL_BANNER_URL=

# ── Mailcow (production) ───────────────────────────────────────────────────────
# After Mailcow is running on mail.hashcode.digital, replace the SMTP_* values above:
# SMTP_HOST=mail.hashcode.digital
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@rabotka.work
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@rabotka.work
# SMTP_FROM_NAME=Rabotka
# SMTP_MOCK=false

# ── Redis ──────────────────────────────────────────────────────────────────────
# General cache + state.
# Production (shared host, DB 4): redis://rabotka:<pwd>@host.docker.internal:6379/4
# Local dev: leave REDIS_URL blank and set REDIS_HOST/REDIS_PORT instead.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# BullMQ queues.
# Production (shared host, DB 5): redis://rabotka:<pwd>@host.docker.internal:6379/5
# Leave blank locally — QueueService falls back to the REDIS_CONNECTION.
REDIS_QUEUE_URL=

RUN_QUEUE_WORKER=false

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Which backend actually sends. Switching providers is this variable plus a
# restart, and rollback is the same. Validated at boot: the selected provider's
# variables are required, the other's are not — but keep BOTH sets populated in
# staging and production, because rollback depends on it.
# See docs/whatsapp-providers.md.
#
# twilio | cloud
WHATSAPP_PROVIDER=twilio

# Twilio (WhatsApp, and optional SMS which shares the same account)
# Required when WHATSAPP_PROVIDER=twilio. These used to be settable from the
# admin settings page; they are environment-only now.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# TWILIO_SMS_FROM=  # Optional, for SMS
# TWILIO_WEBHOOK_BASE_URL=  # Optional. When behind ngrok/tunnel, set to the public URL (e.g. https://xxx.ngrok.io) so signature validation uses the URL Twilio called.

# Meta WhatsApp Cloud API
# Required when WHATSAPP_PROVIDER=cloud.
WHATSAPP_CLOUD_API_VERSION=v25.0
# Meta app -> WhatsApp -> API Setup
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# System user token. The one shown on the API Setup page is temporary (24h).
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Meta app -> Settings -> Basic -> App Secret. Verifies X-Hub-Signature-256.
WHATSAPP_CLOUD_APP_SECRET=
# Any string you choose; must match what you type into the Meta dashboard.
WHATSAPP_CLOUD_VERIFY_TOKEN=
# Meta app -> WhatsApp -> API Setup, or Business Settings -> WhatsApp Accounts.
WHATSAPP_CLOUD_WABA_ID=
# Meta app -> Paramètres de l'app -> Général. Needed only to upload template
# media, which runs against the app rather than the WABA.
WHATSAPP_CLOUD_APP_ID=
# Published feedback Flow. Create one with
# scripts/whatsapp-flows/create-feedback-flow.ts --commit
# Unset, feedback falls back to a link to the web form.
WHATSAPP_FEEDBACK_FLOW_ID=
# Public base for the WhatsApp card cover ONLY. Separate from
# CLOUDFLARE_PUBLIC_BASE_URL on purpose: that one serves user files from the
# storage bucket, while the cover lives in the bucket the approved cards point
# at. Leave unset unless the cover moves — the built-in default is correct.
WHATSAPP_MEDIA_BASE_URL=

# Frontend URL for verification links
FRONTEND_URL=http://localhost:3000

# Public base URL of this backend (no trailing slash).
# Used to build absolute asset URLs in emails (e.g. the logo image).
# Production example: https://api.rabotka.work
BACKEND_URL=http://localhost:8000

# Storage Driver: S3, CLOUDINARY, VERCEL_BLOB, CLOUDFLARE
DRIVER=S3

# S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_ENDPOINT_URL=  # For LocalStack

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob Configuration
BLOB_READ_WRITE_TOKEN=

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
# A SECOND bucket, which must never be made public. It holds only KYC files —
# identity documents and the selfies held next to them — served through signed
# urls that expire after an hour.
#
# It exists because R2 has no per-object ACL: a bucket is public or private as
# a whole. Avatars, chat and claim images legitimately need durable public
# urls, so the bucket above stays public and identity documents move out of it.
#
# Like every other storage setting, the deployed value comes from
# `storage.cloudflare.kyc_bucket_name` in admin › configuration système; this
# line is for local development. If neither is set, KYC uploads FAIL rather
# than falling back to the public bucket.
CLOUDFLARE_KYC_BUCKET_NAME=
# Public bucket/custom domain URL used for non-expiring public image links
CLOUDFLARE_PUBLIC_BASE_URL=

# Image watermark (applied to all uploaded images before storage)
# Path to Rabotka logo (absolute or relative to project root). Default: assets/rabotka-logo.png
WATERMARK_LOGO_PATH=assets/rabotka-logo.png
# Logo opacity 0-1 (default 0.3)
WATERMARK_OPACITY=0.3

# ── Vector search (Qdrant) ─────────────────────────────────────────────────────
# Production (shared host): http://host.docker.internal:6333
# Local dev: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Web session token (the one inside the cookie). Keep in step with
# AUTH_COOKIE_MAX_AGE_DAYS below: a shorter token means the browser keeps
# sending a session the server already refuses, with no way to refresh it.
JWT_EXPIRES_IN=30d
# Defaults to 30 when unset. Move it and JWT_EXPIRES_IN together.
# AUTH_COOKIE_MAX_AGE_DAYS=30
# Mobile token TTLs (bearer flow): short-lived access + longer-lived refresh
# Mobile access token is long-lived (no client refresh flow); logout still revokes via blocklist.
JWT_ACCESS_EXPIRES_IN=3650d
JWT_REFRESH_EXPIRES_IN=24h


# ── Vova AI (assistant) ────────────────────────────────────────────────────────
# Provider credentials. A tier silently drops any provider whose key is blank —
# the resolved chain per tier is logged once at boot, so check that line rather
# than guessing which model answered.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Model ids, overridable because vendors rename and retire them on their own
# schedule. The Google defaults are `-latest` aliases on purpose: a pinned id
# was retired mid-project and answered 404. Pin one here if a model change ever
# regresses the evals.
# Anthropic ids carry no date suffix — `claude-haiku-4-5`, not
# `claude-haiku-4-5-20251001`. Pin a dated snapshot here if one is ever needed.
# VOVA_MODEL_STANDARD_ANTHROPIC=claude-haiku-4-5
# VOVA_MODEL_CHEAP_GOOGLE=gemini-flash-lite-latest
# The standard tier carries TWO Google entries. The FAST one leads the pair
# (~1.4s median on a tool-calling turn); `..._GOOGLE` is the capable one behind
# it. They get separate breaker keys, so one failing does not skip the other.
# VOVA_MODEL_STANDARD_GOOGLE_FAST=gemini-flash-lite-latest
# VOVA_MODEL_STANDARD_GOOGLE=gemini-3.6-flash
# VOVA_MODEL_STANDARD_MISTRAL=mistral-small-latest
# Groq is the exception to the alias rule above: it publishes none, so this id
# is pinned and WILL eventually be retired. Override it here when that happens.
# VOVA_MODEL_STANDARD_GROQ=llama-3.3-70b-versatile
# VOVA_MODEL_STANDARD_DEEPSEEK=deepseek-chat
# VOVA_MODEL_STANDARD_OPENAI=gpt-4o-mini

# Per-attempt budget, per provider. Measured, not guessed: a tool-calling turn
# with the system prompt and tool schemas takes well over 8s on a cold call, and
# 8000 here made every agent turn time out and fall through to a refusal.
# Sequence length every embedding is computed at. fastembed pads to this
# value rather than to the text, so a 15-token WhatsApp question otherwise runs
# a full 512-position pass through a 1GB model. Measured on the corpus model:
# 1618ms at 512, 762ms at 256, 370ms at 128 — for identical vectors (e5
# mean-pools over the attention mask, so padding contributes nothing; cosine
# against the 512 vector is 1.000000). Nothing needs re-ingesting.
#
# The ceiling is `expandQuery`, which appends aliases: the longest realistic
# expansion measured ~190 chars, a category description ~180. 256 leaves ~4x
# headroom. Over it, text is TRUNCATED silently — HelpEmbeddingsService logs a
# warning before that happens.
#
# `scripts/vova-ingest.ts` forces 512 for itself: corpus chunks are 350 words.
# VOVA_EMBED_MAX_LENGTH=256

# Load the ~1GB embedder at boot instead of on the first message. Measured cold
# start is 3864ms to init it, against ~500ms for every lazy import combined —
# this, not the LLM connection, is what the first person waits for.
#
# OFF by default: it moves ~1GB of RSS into startup, and this module has already
# pushed the app past its 150MB terminus limit once (/health 503, failed deploy
# smoke test). Turn it on once the headroom is measured on the target host.
# VOVA_WARMUP=false

# Build the CHAT MODELS at boot, so no user's turn pays an SDK cold start.
#
# Separate from VOVA_WARMUP above, and a comma list rather than a boolean, for
# one reason: the provider SDKs are imported dynamically because loading all of
# them costs ~83MB and pushed the app past its 150MB terminus limit (/health
# 503, failed deploy smoke test). Warming everything recreates that regression
# at boot — where it fails the whole deploy instead of one message.
#
# Name only the providers the race actually uses. `google,openai` is ~20MB;
# Mistral alone is 67MB and should stay lazy. Never blocks boot, and a failure
# just means the next request rebuilds that model as it does today.
#
# Production, 2026-09-01, four seconds AFTER the user had been answered:
#   Built chat model anthropic:claude-haiku-4-5
# VOVA_WARMUP_PROVIDERS=google,openai

# The turn budget, and how it is divided.
#
# `vova.timeout_ms` (SystemConfig, default 25000) is the whole turn. Every model
# call is clamped inside what is LEFT of it, so these are ceilings rather than
# independent numbers. Keep the invariant:
#
#   VOVA_LLM_TIMEOUT_MS + VOVA_FALLBACK_RESERVE_MS <= vova.timeout_ms
#
# It was violated before: 20000 + nothing against 25000 meant one stalled call
# ate 80% of the turn and the fallback chain could not be reached at all — a
# second provider only ever helped the NEXT message. That is the bug this
# arithmetic exists to prevent, so re-check it whenever you move one of them.
#
# Per-attempt ceiling, per provider.
# VOVA_LLM_TIMEOUT_MS=12000
# Held back so a fallback is reachable inside the SAME message. Released for the
# last provider in the chain, which has nobody left to save time for.
# VOVA_FALLBACK_RESERVE_MS=7000
# Below this a call is not "short", it is a guaranteed timeout that still bills
# a full prompt — so it is refused instead of issued.
# VOVA_LLM_MIN_CALL_MS=1500
# Least budget worth starting a whole agent run with. Stops the chain walking on
# after the user has already been sent the fallback card.
# VOVA_MIN_RUN_MS=5000
# VOVA_LLM_RETRY_BACKOFF_MS=250
# VOVA_TEMPERATURE=0.2

# ── Racing agent runs ──────────────────────────────────────────────────────────
# Instead of waiting for a provider to hard-fail, start the next one alongside
# it and take whichever answers. Safe here only because all 14 tools are
# read-only (`agent/read-only.ts` enforces it): two runs duplicate database
# reads, but cannot double-execute a side effect.
#
# OFF by default — it doubles tokens and DB reads on the turns it fires.
# VOVA_HEDGE_ENABLED=false
#
# Head start the LEADING provider gets alone. It only loses if it is more than
# this much slower than the next one, which means it is genuinely degraded.
# Set to 0 to start every permitted run at once (the all-at-once race).
# VOVA_HEDGE_MS=3500
#
# How many runs may be in flight for ONE turn.
# Do NOT raise this to the full chain length: each provider loads its own SDK,
# and all six together cost ~83MB — the regression that broke the 150MB
# terminus limit. Racing everything also means the fastest model wins every
# time, which over a quality-diverse chain is reliably the weakest one.
# VOVA_HEDGE_MAX_PARALLEL=2
#
# How many hedges may run across the WHOLE PROCESS. Without this, a vendor-wide
# slowdown makes every concurrent turn hedge at the same instant, doubling load
# on the database and on provider 2 exactly when the system can least absorb it.
# This is the difference between a latency tool and an outage amplifier.
# VOVA_HEDGE_MAX_CONCURRENT=8
#
# Do not start a hedge with less than this left in the turn — a run that cannot
# finish is double spend for an answer nobody will read.
# VOVA_HEDGE_MIN_REMAINING_MS=8000
#
# Chain order is a PREFERENCE, not just a start order. If a lower-priority run
# finishes first, its answer is held this long; a higher-priority run landing
# inside the window wins instead. Set to 0 for pure "first success wins" —
# expect quality drift toward whichever model is merely fastest.
# VOVA_RACE_PREFERENCE_GRACE_MS=800

# ── Health-ordered chain ───────────────────────────────────────────────────────
# The breaker answers "is this provider dead?", which is a cliff: five failures
# and it disappears, four and it still leads the chain. A degrading provider
# lives in that gap, and on a WhatsApp budget one taking 9s is barely better
# than one that is down.
#
# The scoreboard is WRITTEN from the first deploy regardless of this flag, so
# vova_llm_health_score and vova_llm_chain_position have real data to watch.
# Only the reordering is gated — a chain that rearranges itself is not something
# to meet for the first time during an incident.
# VOVA_HEALTH_ENABLED=false
#
# EWMA weight on the newest successful call. Successes only: a provider that
# 401s in 200ms must not score as the fastest thing in the chain.
# VOVA_HEALTH_ALPHA=0.3
#
# Keep this SHORTISH. A demoted provider gets no traffic, so its entry goes
# stale, expires, and it is tried again at the default score. That loop is the
# self-healing — a long TTL breaks it.
# VOVA_HEALTH_TTL_S=900
#
# Assumed latency for a provider with no recent traffic.
# VOVA_HEALTH_DEFAULT_MS=4000
#
# Beta-smoothing prior on the success rate, so one lucky sample cannot promote
# an unproven provider to the head of the chain.
# VOVA_HEALTH_PRIOR=3
#
# How much better a provider must be to overtake the one ahead of it. The
# static order is hand-tuned and argued for at length in models.config.ts; this
# is an override for outliers, not a replacement for that judgement. A free sort
# would rewrite the chain on noise.
# VOVA_HEALTH_MIN_GAIN_RATIO=1.25

# How hard a Gemini model is allowed to think before it answers.
#
# Unconstrained, `gemini-3.6-flash` spent 5116ms on a turn whose whole output was
# a 28-token tool call, then stalled a second step past the per-attempt cap and
# expired the turn budget before the chain could reach another provider. VoVa's
# turns are lookups, not proofs, so thinking here is paid in wall clock for
# nothing.
#
# LOW | MEDIUM | HIGH | THINKING_LEVEL_UNSPECIFIED, or `off`.
# `off` sends `thinkingBudget: 0`, which Gemini 2.x accepts and 3.x REJECTS
# (3.x requires a level of at least LOW) — it fails loudly there by design.
# An unrecognised value logs a warning and falls back to LOW.
# VOVA_GOOGLE_THINKING_LEVEL=LOW

# Ceiling on retrieval, so grounding can never starve the model call.
#
# The turn budget is spent in phases: categories, history, retrieval, then the
# model. Before this, retrieval had no ceiling and could take all of it — on
# 2026-09-01 it took the entire 25s and the model was never called at all.
#
# The slice is capped at `remaining - VOVA_MIN_RUN_MS - 250ms handoff`, so
# whatever retrieval does, a run still fits. On expiry the assistant answers
# WITHOUT corpus grounding rather than not answering: HelpRetrieveService
# already returns empty hits on failure, so that path is not new.
#
# It caps how long we WAIT. It cancels nothing — the embed runs to completion.
# And while a synchronous ONNX embed holds the event loop no timer fires at
# all, so the turn that owns a cold embed still pays in full; what this saves
# is the turns queued behind it.
# VOVA_RETRIEVAL_BUDGET_MS=4000

# ── Qdrant timeouts ────────────────────────────────────────────────────────────
# The client library defaults to 300000ms. Five minutes, on a call a person is
# waiting through. It has never fired only because Qdrant has been healthy.
#
# Two clients: the shared one is a safety net that cannot break ingestion
# (`scroll(limit:1000)` and batched upserts legitimately take minutes), and a
# second tight one used ONLY by the help search inside a VoVa turn.
#
# Keep this invariant — the help search runs inside retryTransient(3):
#
#   3 × QDRANT_SEARCH_TIMEOUT_MS + 450ms  <=  VOVA_RETRIEVAL_BUDGET_MS
#         3 × 1000 + 450 = 3450           <=  4000   OK
#
# It holds only because a client-side timeout is not classed as transient and
# so is not retried; `qdrant.service.spec.ts` pins that.
# QDRANT_TIMEOUT_MS=30000
# QDRANT_SEARCH_TIMEOUT_MS=1000


# Circuit breaker: consecutive failures before a provider is skipped, how long
# it stays skipped, and how long a failure counts toward the threshold.
# VOVA_BREAKER_THRESHOLD=5
# VOVA_BREAKER_COOLDOWN_S=60
# VOVA_BREAKER_WINDOW_S=120

# How long the assistant caches the job-category list. Categories are mutable at
# runtime (admins create and delete them), so this is a staleness budget, not a
# constant — an admin's new domain becomes searchable within one TTL.
# VOVA_CATEGORY_TTL_MS=300000

# How many corpus chunks a help lookup returns.
# VOVA_RETRIEVAL_LIMIT=5

# Below this retrieval score a question is logged as `vova.gap` — a question the
# corpus could not answer. Those lines are the input to the next article; they
# are NOT fed back automatically (see src/modules/rag/docs/PROJECT_CONTEXT.md).
# VOVA_GAP_SCORE=0.55

# ---------------------------------------------------------------------------
# "Login with Rabotka" — Rabotka as an OpenID Connect provider
# ---------------------------------------------------------------------------
# Generate a keypair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out oidc.pem
#   base64 < oidc.pem | tr -d '\n'         # -> OIDC_PRIVATE_KEY
#
# `base64 < file`, not `base64 -i file`: on macOS `-i` names the input file, but
# on GNU coreutils it means --ignore-garbage, which is a decode flag. Redirecting
# stdin behaves identically on both. `tr -d '\n'` is not optional — the value is
# written into a shell heredoc during deploy, where a line break would corrupt
# that line and every one after it.
#
# The exact string that appears as `iss` in every ID token, and the base of
# every URL in the discovery document. Partners compare it byte-for-byte
# against the token's `iss`, so it must not gain or lose a trailing slash or a
# scheme once partners exist. Changing it breaks every live integration.
OIDC_ISSUER=http://localhost:8000

# RS256 private key, PKCS#8 PEM. Base64 is accepted (and is what survives
# multi-line-hostile env editors); a literal PEM works too. Boot fails without
# it rather than failing at the first partner login.
#
# This is NOT `JWT_SECRET` and must never be set to it: every other token in
# this app is HS256 under one shared symmetric secret, and anyone who can
# verify one of those can also mint one. Partners must be able to verify an ID
# token without being able to forge an admin session.
OIDC_PRIVATE_KEY=
# Names the key in the JWKS and in each token's JWS header. Any stable string.
OIDC_KEY_ID=rabotka-oidc-1

# Optional, and only during a key rotation: the PUBLIC half (SPKI PEM) of the
# key you just stopped signing with. Published alongside the new one so tokens
# already in partners' hands keep verifying for their last hour of life.
OIDC_PUBLIC_KEY_PREVIOUS=
OIDC_KEY_ID_PREVIOUS=

# 32+ random bytes: `openssl rand -base64 32`
# Salts the per-application `sub`, so two partners cannot discover they share a
# user. NEVER ROTATE THIS. Partners key their own user tables on the `sub` it
# produces; changing it orphans every account every partner has ever created,
# with no way to reconcile them.
OIDC_PAIRWISE_SALT=

# -----------------------------------------------------------------------------
# Exposure
# -----------------------------------------------------------------------------
# The interactive API reference at /api-docs. Always on outside production; in
# production it is served only when this is exactly "true".
API_DOCS_ENABLED=
# /metrics answers a scraper inside the Docker network without any of this. Set
# a token only if the scraper has to come through the public hostname, and send
# it as "Authorization: Bearer <token>".
METRICS_TOKEN=
# Extra hosts GET /file/proxy may fetch from, comma-separated. The hosts of the
# configured storage are allowed already; this is for files kept elsewhere.
PROXY_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Sessions and cookies
# -----------------------------------------------------------------------------
# Name of the session cookie. Required: the API throws on the first login
# without it.
AUTH_COOKIE_NAME=rabotka_session
# Profile session length in days (default 30). Keep JWT_EXPIRES_IN in step.
AUTH_COOKIE_MAX_AGE_DAYS=30
# Admin session length in hours (default 12) — token and cookie both.
ADMIN_SESSION_HOURS=12
# "true" behind https: Secure, SameSite=None and the __Host- CSRF cookie.
SECURE_COOKIES=false
# Where the admin app is served; QR login links and socket origins use it.
ADMIN_BASE_URL=http://localhost:3200
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# MONETBIL or MTN_MOMO. Required by the payment page.
PAYMENT_GATEWAY_DRIVER=
MONETBIL_SERVICE_KEY=
MTN_MOMO_BASE_URL=
MTN_MOMO_ENVIRONMENT=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_COLLECTION_PRIMARY_KEY=
# Where MTN posts its result: <API url>/api/v1/webhooks/payment/mtn-momo
MTN_MOMO_CALLBACK_URL=
# Shared secret for POST /webhooks/payment/penalties/:profileId (x-webhook-secret).
WEBHOOK_SECRET=
# Public base url Twilio signs its webhook against, when behind a proxy.
TWILIO_WEBHOOK_BASE_URL=
