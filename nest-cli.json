{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/**/*",
        "watchAssets": true
      },
      {
        "include": "modules/mail/templates/**/*.mjml",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "modules/geo/data/*.json",
        "outDir": "dist/src",
        "watchAssets": false
      },
      {
        "include": "modules/rag/retrieval/corpus/**/*.md",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}
