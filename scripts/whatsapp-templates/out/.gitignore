# Generated by generate.ts / create.ts. fixtures.json is committed on purpose —
# the translation tests run against it, and a test whose input is not in the
# repo silently skips in CI.
payloads/
report.md
created.json
media-handle.json

# Upload handles and the sample documents behind a DOCUMENT header, from
# upload-media.ts. Same class as media-handle.json above: one-shot artifacts
# that go stale, and the PDFs are 50KB binaries regenerated on demand.
document-handle.*.json
sample-*.pdf
