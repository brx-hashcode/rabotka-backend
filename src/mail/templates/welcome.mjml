<mjml>
  <mj-body background-color="#f8fafc" width="520px">
    {{!-- Content: greeting and copy --}}
    <mj-section background-color="#ffffff" padding="36px 32px 24px">
      <mj-column width="100%">
        <mj-text color="#0f172a" font-size="24px" font-weight="700" padding="0 0 8px 0">
          Hi {{name}},
        </mj-text>
        <mj-text color="#475569" font-size="15px" padding="0 0 16px 0">
          Thanks for joining us. We're glad you're here.
        </mj-text>
        <mj-text padding="0 0 16px 0">
          Your account has been successfully created. You now have full access to <strong style="color: #0f766e;">our platform</strong> and all its features.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
