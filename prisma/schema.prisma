model Claim {
  id                    String      @id @default(uuid()) @db.Uuid
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  title                 String
  description           String      @db.Text
  status                ClaimStatus @default(CREATED)
  attachment_urls       String[]    @default([])
  profile_id            String      @db.Uuid
  assigned_user_id      String?     @db.Uuid
  /// Who performed the current assignment, and therefore the only person who
  /// may undo it. NULL means the assignment predates this column, or nobody is
  /// assigned — in both cases the restriction does not apply.
  assigned_by_user_id   String?     @db.Uuid
  created_by_user_id    String?     @db.Uuid
  created_by_profile_id String?     @db.Uuid

  /// Manual rank within the board column, ascending. Fractional so a drag
  /// writes one row — the moved claim lands on the midpoint between its new
  /// neighbours — instead of renumbering everything below it. Ties (all new
  /// claims default to 0, i.e. top of their column) break on created_at desc.
  position Float @default(0)

  profile            Profile        @relation("ClaimProfile", fields: [profile_id], references: [id], onDelete: Cascade)
  assigned_user      User?          @relation("ClaimAssignedUser", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  assigned_by_user   User?          @relation("ClaimAssignedByUser", fields: [assigned_by_user_id], references: [id], onDelete: SetNull)
  created_by_user    User?          @relation("ClaimCreatedByUser", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  created_by_profile Profile?       @relation("ClaimCreatedByProfile", fields: [created_by_profile_id], references: [id], onDelete: SetNull)
  comments           ClaimComment[]

  @@index([profile_id])
  @@index([status])
  @@index([assigned_user_id])
  @@index([status, position])
  @@map("claims")
}

model ClaimComment {
  id              String   @id @default(uuid()) @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  claim_id        String   @db.Uuid
  /// Empty string for an image-only message. NOT nullable: every reader treats
  /// this as a string today, and a nullable column would push a null check into
  /// all of them to express something `''` already says.
  content         String   @db.Text
  /// Public-bucket urls, same shape as `Claim.attachment_urls`. Validated on
  /// write against `claim-attachments/` — see `claim-attachment-key.ts`.
  attachment_urls String[] @default([])
  user_id         String?  @db.Uuid
  profile_id      String?  @db.Uuid
  created_by_type String   @default("user")

  claim   Claim    @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  user    User?    @relation("ClaimCommentUser", fields: [user_id], references: [id], onDelete: SetNull)
  profile Profile? @relation("ClaimCommentProfile", fields: [profile_id], references: [id], onDelete: SetNull)

  @@index([claim_id])
  @@map("claim_comments")
}

/// A repeat rule. Its occurrences are real `events` rows carrying `series_id`,
/// not virtual expansions — every consumer of an event keys on the numeric
/// event id (React keys, drag/drop, PATCH/DELETE /admin/event/:id), and a
/// virtual occurrence has no such id to offer.
///
/// `materialised_until` is how far ahead the rows have actually been written.
/// A series with no end date is generated a year out and topped up lazily when
/// someone browses past it, which is why the rule lives here rather than being
/// copied onto every occurrence: a top-up is one row update, not N.
model EventSeries {
  id                 String              @id @default(uuid()) @db.Uuid
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  frequency          RecurrenceFrequency
  /// The first occurrence — the reference point every later one is computed
  /// from, so a month series anchored on the 31st keeps trying for the 31st
  /// rather than drifting off a clamped February.
  anchor_start       DateTime
  anchor_end         DateTime
  /// End condition. At most one is set; both null means open-ended.
  until              DateTime?
  count              Int?
  materialised_until DateTime

  events Event[]

  @@index([materialised_until], name: "idx_event_series_materialised_until")
  @@map("event_series")
}

model Event {
  id            Int             @id @default(autoincrement())
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  title         String
  description   String          @db.Text
  start_date    DateTime
  end_date      DateTime
  color         String
  channel       DeliveryChannel @default(EMAIL)
  location      String?
  created_by_id String          @db.Uuid

  /// Null for a one-off event, which is every event created before recurrence
  /// existed. Every code path branches on this being set.
  series_id        String? @db.Uuid
  occurrence_index Int?

  created_by     User         @relation("EventCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  series         EventSeries? @relation(fields: [series_id], references: [id], onDelete: Cascade)
  profiles       Profile[]    @relation("EventProfiles")
  assigned_users User[]       @relation("EventAssignedUsers")

  @@index([created_by_id], name: "idx_event_created_by")
  // Serves the calendar's overlap query (start_date <= to AND end_date >= from).
  // Replaces a lone start_date index, which this one subsumes as its leading
  // column.
  @@index([start_date, end_date], name: "idx_event_start_end")
  // Every scoped operation is "this series, from this date on".
  @@index([series_id, start_date], name: "idx_event_series_start")
  @@map("events")
}

