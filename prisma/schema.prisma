/// Whether a partner application may currently authenticate anybody.
///
/// SUSPENDED is checked at BOTH `authorize` and `token`, not just at authorize:
/// a code minted seconds before a suspension must not still be redeemable, and
/// the two endpoints are minutes apart in the worst case.
enum OAuthAppStatus {
  ACTIVE
  SUSPENDED
}

/// A third-party application registered for "Login with Rabotka".
///
/// Rabotka acts as an OpenID Connect provider for these: the partner redirects
/// a user here, the user proves their phone over the usual WhatsApp OTP, and
/// the partner receives an ID token carrying the identity AND Rabotka's KYC
/// verdict. The verdict is the product — anyone can ask for a phone number.
model OAuthApp {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String  @db.Text
  /// Rendered on the consent screen. This is the face the user is asked to
  /// trust, so an app without one shows its initials rather than nothing.
  logo_url    String?

  /// Public, opaque, and NOT the primary key: `client_id` travels in query
  /// strings and partner config files, so it must be safe to expose and free
  /// to rotate independently of the row it points at.
  client_id String @unique

  /// SHA-256 hex of the secret, never the secret — and the ONLY thing
  /// authentication consults, including for a sandbox app.
  ///
  /// Deliberately not bcrypt/argon: the secret is 32 bytes straight out of a
  /// CSPRNG, so there is no dictionary and no rainbow table for a slow KDF to
  /// defend against. A work factor here would buy nothing and add latency to
  /// every single token exchange. Comparison is still constant-time — see
  /// `client-credentials.util.ts`.
  client_secret_hash String
  /// Last 4 characters of the secret. For a real app this is the only way to
  /// tell two of them apart when asking a partner "which one are you using",
  /// because the secret itself cannot be read back. A SANDBOX app is the one
  /// exception — see `sandbox_client_secret_plaintext`.
  client_secret_hint String

  /// The secret IN PLAINTEXT, and only ever for a sandbox app.
  ///
  /// `client_secret_hash` above remains the sole source of truth for
  /// authentication: `authenticateClient` never reads this column. It exists
  /// only so an admin can be shown the secret again.
  ///
  /// WHY THIS IS ACCEPTABLE HERE AND NOWHERE ELSE. A sandbox app signs in only
  /// the two synthetic users in `oauth-sandbox.service.ts`, with the fixed OTP
  /// `111111` — which `GET /admin/oauth-apps/sandbox-users` already returns in
  /// the clear to the same SUPER_ADMIN who can read this. The secret therefore
  /// guards nothing that was not already visible to its only reader. It is the
  /// "test key" model: readable in the dashboard, unlike a live key.
  ///
  /// NULL for every real app, and NULL for sandbox apps registered before this
  /// column existed — their secret is genuinely gone and no migration can
  /// recover it. The UI tells those to rotate once.
  ///
  /// Its safety rests on `is_sandbox` being written once and never updated. If
  /// that ever changes, the same statement must null this column.
  ///
  /// Deliberately NOT mirrored for `previous_secret_hash`: after a rotation the
  /// old secret keeps authenticating for the grace window but its plaintext is
  /// overwritten immediately. That asymmetry is intentional — the reveal
  /// endpoint answers "what should the partner use NOW", and handing back a
  /// superseded credential that dies in a few hours would be a trap.
  sandbox_client_secret_plaintext String?

  /// Set on rotation. The old secret keeps working until it expires, so a
  /// partner can redeploy on their own schedule instead of taking downtime the
  /// moment an admin clicks the button.
  previous_secret_hash       String?
  previous_secret_expires_at DateTime?
  secret_rotated_at          DateTime?

  /// Exact-match allowlist. No wildcards and no patterns, ever: a redirect_uri
  /// that is matched loosely is an open redirector, and an open redirector on
  /// an authorization endpoint hands authorization codes to whoever asked.
  /// See RFC 9700 §4.1.
  redirect_uris String[]

  /// The ceiling on what this app may request. A scope absent here is refused
  /// at `authorize` rather than silently dropped, so a partner discovers the
  /// misconfiguration immediately instead of shipping against claims that
  /// never arrive.
  allowed_scopes String[]

  /// Where identity-check results are POSTed, as an RS256 JWS signed with the
  /// OIDC key. Required whenever `allowed_scopes` holds
  /// `rabotka:identity_check` — enforced in `OAuthAppService`, since the rule
  /// spans two columns. `https` only, except `http://localhost` for sandbox.
  webhook_url String?

  status OAuthAppStatus @default(ACTIVE)

  /// A sandbox application: it authenticates ONLY the two hardcoded Rabotka
  /// sandbox users, with a fixed OTP, and never touches `profiles`. It exists
  /// so a partner can build their integration without a real account and
  /// without a real WhatsApp message.
  ///
  /// This flag is the only gate — there is deliberately no environment check,
  /// so a sandbox app works in production too. That makes it an explicit
  /// SUPER_ADMIN decision at registration rather than a property of where the
  /// code happens to be running.
  ///
  /// Set once and never updated. Flipping it would not migrate the identities
  /// already issued: `pairwise_sub` is what a partner keys their own user table
  /// on, and it does not change when the flag does, so a synthetic identity
  /// would end up sitting in a partner's production table indistinguishable
  /// from a real person's. Changing it means deleting the app and registering a
  /// new one, which forces new credentials — correct, because the identity
  /// semantics of that `client_id` have changed.
  is_sandbox Boolean @default(false)

  /// Who to contact about this integration. Not an account — partners have no
  /// login here; registration is an admin action.
  contact_email String

  created_by String? @db.Uuid
  creator    User?   @relation("OAuthAppCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  authorizations  OAuthAuthorization[]
  identity_checks IdentityCheck[]
  api_requests    PartnerApiRequest[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? @db.Timestamptz

  @@index([client_id], name: "idx_oauth_app_client_id")
  @@index([status], name: "idx_oauth_app_status")
  @@index([deleted_at], name: "idx_oauth_app_deleted_at")
  @@map("oauth_apps")
}

/// One user's standing consent for one application.
///
/// Exists so that a returning user is not asked to consent again, and so that
/// both the user and an admin have something concrete to revoke. Its real job,
/// though, is to be the stable home of `pairwise_sub`.
model OAuthAuthorization {
  id         String @id @default(uuid()) @db.Uuid
  app_id     String @db.Uuid
  profile_id String @db.Uuid

  /// The `sub` claim this app sees for this person, forever.
  ///
  /// Derived as sha256(app_id + profile_id + OIDC_PAIRWISE_SALT) but STORED,
  /// not recomputed on demand, for two reasons: partners key their own user
  /// tables on it, so it must survive any future change to how it is derived;
  /// and being a real column makes "which Rabotka profile is this partner
  /// asking about" a lookup rather than a brute-force search.
  ///
  /// Pairwise rather than a bare profile id so that two partners comparing
  /// notes cannot discover they share a user.
  pairwise_sub String @unique

  /// What was actually granted, which is not necessarily what was requested:
  /// scopes are intersected with the app's `allowed_scopes` first.
  scopes String[]

  granted_at   DateTime  @default(now())
  /// Moved on every token exchange, throttled to the minute. Answers "is this
  /// integration still live" without reading the audit log.
  last_used_at DateTime?
  /// The kill switch, for the user and for an admin. Non-null means every
  /// access token is dead and the next `authorize` must re-consent. Kept as a
  /// timestamp rather than a delete so revocation is auditable.
  revoked_at   DateTime?

  app     OAuthApp @relation(fields: [app_id], references: [id], onDelete: Cascade)
  profile Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([app_id, profile_id], name: "idx_oauth_authorization_app_profile")
  @@index([profile_id], name: "idx_oauth_authorization_profile")
  @@index([app_id, revoked_at], name: "idx_oauth_authorization_app_revoked")
  @@map("oauth_authorizations")
}

/// Where an identity check stands.
///
/// Only two outcomes, on purpose. A person who declined, a person who never
/// answered and a number with no account all end as NOT_COMPLETED: telling a
/// partner which one it was would turn the API into a way of learning who is on
/// Rabotka without anyone's consent.
enum IdentityCheckStatus {
  PENDING_CONSENT
  COMPLETED
  NOT_COMPLETED
}

/// A partner asking "is the person behind this WhatsApp number who they claim
/// to be?".
///
/// The person is asked on WhatsApp and decides in the app. Only once they
/// approve is the claim scored against their verified profile, and the partner
/// receives match levels and a score — never the stored data itself.
model IdentityCheck {
  id     String   @id @default(uuid()) @db.Uuid
  app_id String   @db.Uuid
  app    OAuthApp @relation(fields: [app_id], references: [id], onDelete: Cascade)

  /// The profile the number resolved to, or null when it resolved to none.
  /// Never returned to the partner.
  profile_id String?  @db.Uuid
  profile    Profile? @relation(fields: [profile_id], references: [id], onDelete: SetNull)

  /// For a sandbox app: which synthetic user the number matched. Sandbox
  /// subjects are not uuids and have no profile row to point at.
  sandbox_subject String?

  /// What the partner sent, normalised, as E.164.
  phone_e164 String

  /// The identity the partner claims (names, country, city, document type).
  /// Personal data the partner already held; cleared by the retention sweep
  /// once the check is long finished.
  claimed Json?

  /// The partner's own id for this check, echoed back untouched.
  reference       String?
  /// From the `Idempotency-Key` header. A retry returns the original check.
  idempotency_key String?

  status          IdentityCheckStatus @default(PENDING_CONSENT)
  expires_at      DateTime            @db.Timestamptz
  /// When the WhatsApp consent request went out. Null when none was sent:
  /// no account, a sandbox app, or the per-number cap reached.
  consent_sent_at DateTime?           @db.Timestamptz
  decided_at      DateTime?           @db.Timestamptz
  /// Internal only — the partner sees NOT_COMPLETED either way.
  declined        Boolean?

  /// The partner-facing result, frozen when the person approved.
  result Json?
  score  Int?

  webhook_attempts     Int       @default(0)
  webhook_delivered_at DateTime? @db.Timestamptz
  webhook_last_error   String?

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt

  @@unique([app_id, idempotency_key], name: "idx_identity_check_app_idempotency")
  @@index([app_id, phone_e164, created_at], name: "idx_identity_check_app_phone_time")
  @@index([status, expires_at], name: "idx_identity_check_status_expiry")
  @@index([profile_id, status], name: "idx_identity_check_profile_status")
  @@map("identity_checks")
}

/// Which partner call a `PartnerApiRequest` row records.
enum PartnerApiCallKind {
  TOKEN
  USERINFO
  REVOKE
  IDENTITY_CHECK_CREATE
  IDENTITY_CHECK_READ
}

/// One server-to-server call from a partner app, for the admin's activity
/// drawer.
///
/// A readable SUMMARY of the request and the response, never the bodies:
/// no tokens, codes or secrets, and phone numbers masked. Rows older than 90
/// days are deleted by `PartnerRequestLogService`.
model PartnerApiRequest {
  id     String   @id @default(uuid()) @db.Uuid
  app_id String   @db.Uuid
  app    OAuthApp @relation(fields: [app_id], references: [id], onDelete: Cascade)

  kind        PartnerApiCallKind
  status_code Int
  /// `ok`, or the error code the partner received (`invalid_client`, …).
  outcome     String
  duration_ms Int

  request  Json
  response Json

  created_at DateTime @default(now()) @db.Timestamptz

  @@index([app_id, created_at(sort: Desc)], name: "idx_partner_api_request_app_time")
  @@index([created_at], name: "idx_partner_api_request_created")
  @@map("partner_api_requests")
}

/// Where a broadcast is in its life. Terminal states are SENT, CANCELLED and
/// FAILED; SENDING means the fan-out is in flight and the audience is already
/// frozen into `broadcast_recipients`.
enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

/// Per-recipient, per-channel outcome of a broadcast.
enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  /// In-app only: the recipient opened it. The other channels have no such
  /// signal we can attribute back to a broadcast.
  READ
}

/// One message an admin sends to a SEGMENT rather than to a person.
///
/// Announcements — maintenance, a fee change, a recruitment push in one
/// neighbourhood — which until now were sent by hand, one profile at a time,
/// through `POST /admin/profiles/:id/messages`.
///
/// The audience is stored as FILTERS, not as a list: a draft written on Monday
/// and sent on Thursday should reach the people who match on Thursday. The list
/// is materialised into `recipients` at send time, which is also what makes the
/// send idempotent and reportable.
model Broadcast {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  title String
  /// The message itself, as the admin typed it. Rendered per channel: the
  /// in-app row takes it whole, WhatsApp flattens it into the template variable
  /// (Meta rejects newlines there), email wraps it in the layout.
  body  String  @db.Text
  /// Optional in-app path the CTA opens, without the host (`home`, `claims`).
  link  String?

  channels DeliveryChannel[]
  /// The audience filters, shaped by `AudienceFiltersDto`. Json rather than
  /// columns because the filter set will grow, and a broadcast is read far more
  /// often by its counters than by its criteria.
  audience Json

  status       BroadcastStatus @default(DRAFT)
  /// When the fan-out should start. Null means "as soon as it is sent".
  scheduled_at DateTime?
  sent_at      DateTime?

  /// Frozen at send time from the audience snapshot, so a later filter change
  /// cannot rewrite history.
  recipient_count Int @default(0)
  sent_count      Int @default(0)
  failed_count    Int @default(0)
  read_count      Int @default(0)

  /// What the WhatsApp leg was expected to cost, in FCFA, at the moment the
  /// admin confirmed: only the recipients whose 24h window was CLOSED are
  /// billable. Kept so the estimate can be compared against
  /// `whatsapp_messages.billable` afterwards.
  estimated_cost Int @default(0)

  created_by_id String? @db.Uuid
  created_by    User?   @relation(fields: [created_by_id], references: [id], onDelete: SetNull)

  recipients BroadcastRecipient[]

  @@index([status, created_at(sort: Desc)], name: "idx_broadcast_status_created")
  @@index([scheduled_at], name: "idx_broadcast_scheduled")
  @@map("broadcasts")
}

/// One (broadcast, profile, channel) delivery.
///
/// The row is written BEFORE the send, so a retried chunk can tell what it
/// already did — the unique constraint is the idempotency, not a Redis key that
/// expires.
model BroadcastRecipient {
  id           String                   @id @default(uuid()) @db.Uuid
  created_at   DateTime                 @default(now())
  broadcast_id String                   @db.Uuid
  profile_id   String                   @db.Uuid
  channel      DeliveryChannel
  status       BroadcastRecipientStatus @default(PENDING)
  /// Why it failed, truncated. Null on success.
  error        String?
  sent_at      DateTime?

  broadcast Broadcast @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([broadcast_id, profile_id, channel], name: "idx_broadcast_recipient_unique")
  @@index([broadcast_id, status], name: "idx_broadcast_recipient_status")
  @@index([profile_id], name: "idx_broadcast_recipient_profile")
  @@map("broadcast_recipients")
}

/// Whether a message reached its recipient whole, with holes, or not at all.
///
/// CLEAN and REDACTED are both DELIVERED — the difference is only what the
/// recipient sees. HELD is not delivered, and exists for the one case where
/// redaction is impossible: the semantic pass answers a yes/no question and
/// returns no positions, so a message only it catches cannot be holed
/// accurately and is withheld whole rather than mangled.
enum MessageModerationStatus {
  CLEAN
  REDACTED
  HELD
}

/// What kind of contact detail a withheld fragment is.
///
/// Recorded per fragment rather than per message so that "which family
/// produces the false positives" is a query rather than a reading exercise.
/// OBFUSCATED_DIGITS is deliberately its own member: its false-positive rate is
/// structurally the highest of the five, and separating it is what allows it to
/// be switched off alone without blinding the rest.
enum RedactionCategory {
  PHONE
  EMAIL
  MESSAGING_HANDLE
  URL
  OBFUSCATED_DIGITS
}

/// A conversation between a worker and an employer, BEFORE either has paid to
/// unlock the other's contact details.
///
/// The two parties are COLUMNS, not a join table, and that is a deliberate
/// departure from ChatParticipant next door. A conversation here is always
/// exactly two people in asymmetric roles — the unlock fee differs by role, 100
/// vs 500 FCFA — so a join table would permit states the domain forbids: three
/// participants, two workers, a party removed. ContactUnlockAttempt models the
/// same pair the same way.
///
/// CARRIES NO UNLOCK STATE. Whether contacts are unlocked is read from
/// ContactUnlockAttempt.status, which is the one place that decides it. A
/// second copy of a paid-for state is a dispute waiting to be filed.
model ProfileConversation {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  worker_id   String @db.Uuid
  employer_id String @db.Uuid

  /// The CONTEXT of the thread, not its key: the most recent application
  /// between the pair, shown in the header. A pair has ONE conversation however
  /// many applications they share — one chat per contact, like WhatsApp — so
  /// this is updated to the latest one each time the thread is opened from an
  /// application.
  ///
  /// Null when the thread began from a recommended profile, where no
  /// application exists at all.
  application_id String? @db.Uuid

  /// Denormalised, or ordering the conversation list means aggregating over
  /// profile_messages on every open of the tab.
  last_message_at DateTime?

  /// Two columns rather than a read-state table, for the same reason the
  /// participants are columns: there are always exactly two readers.
  worker_last_read_at   DateTime?
  employer_last_read_at DateTime?

  /// "Supprimer la discussion", per side — WhatsApp's meaning: it clears the
  /// thread FOR ME and nobody else.
  ///
  /// Never a delete. The rows are evidence — for a claim, and for reviewing a
  /// redaction — and the other party keeps their whole history. Everything
  /// before this instant disappears from this side's list and thread; a new
  /// message after it brings the conversation back, starting from there.
  worker_hidden_at   DateTime?
  employer_hidden_at DateTime?

  /// Set when the application dies — rejected, cancelled, or the unlock expired
  /// into wallet credit. Read-only from then on, never deleted: it is evidence
  /// for whatever claim follows.
  closed_at DateTime?

  worker      Profile          @relation("ConversationWorker", fields: [worker_id], references: [id], onDelete: Cascade)
  employer    Profile          @relation("ConversationEmployer", fields: [employer_id], references: [id], onDelete: Cascade)
  application Application?     @relation(fields: [application_id], references: [id], onDelete: SetNull)
  messages    ProfileMessage[]

  /// One conversation per pair. The first version keyed on the application,
  /// and the same person showed up once per application plus once more for a
  /// direct message.
  @@unique([worker_id, employer_id], map: "profile_conversations_pair_key")
  @@index([application_id], map: "idx_profile_conversation_application")
  @@index([worker_id, last_message_at(sort: Desc)], name: "idx_profile_conversation_worker")
  @@index([employer_id, last_message_at(sort: Desc)], name: "idx_profile_conversation_employer")
  /// The back-office list, which sorts every conversation on the platform by
  /// recency. The two indexes above lead with a participant, so neither can
  /// serve a global ORDER BY — without this it is a seq scan plus a full sort
  /// on every page.
  @@index([last_message_at(sort: Desc)], name: "idx_profile_conversation_last_message")
  @@map("profile_conversations")
}

/// One message in a profile-to-profile conversation.
///
/// `body` IS THE TEXT AS TYPED, never the redacted version. Three reasons, in
/// order: the sender is shown exactly which of their own characters were
/// withheld and that needs the original plus offsets; a false positive cannot
/// be reviewed against a copy that already hides the evidence; and a pattern
/// found to be too wide can only be corrected retroactively if what it matched
/// still exists.
///
/// The price is real and stated rather than left implicit: contact details sent
/// in breach of the rules sit here in clear text, and this repo has no
/// application-level encryption at rest. What contains it is access — the
/// author, an admin above a role threshold whose read is logged, and the
/// moderation job. The recipient's API response is built from the redactions
/// and never contains the withheld characters.
model ProfileMessage {
  id              String   @id @default(uuid()) @db.Uuid
  created_at      DateTime @default(now())
  conversation_id String   @db.Uuid
  sender_id       String   @db.Uuid

  body String @db.Text

  moderation_status MessageModerationStatus @default(CLEAN)

  /// The semantic pass said "yes" while the deterministic one found nothing.
  /// Separate from moderation_status because it carries no positions: it is why
  /// a message is HELD, not a description of where.
  semantic_flagged Boolean @default(false)

  read_at    DateTime?
  deleted_at DateTime? @db.Timestamptz

  conversation ProfileConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       Profile             @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  redactions   MessageRedaction[]
  reports      RedactionReport[]

  @@index([conversation_id, created_at], name: "idx_profile_message_conversation")
  @@index([sender_id, created_at], name: "idx_profile_message_sender")
  @@map("profile_messages")
}

/// One withheld fragment, as OFFSETS INTO ProfileMessage.body.
///
/// Half-open bounds, [start, end), and UTF-16 indices — the same units
/// JavaScript's String uses, because that is what produced them and what will
/// slice with them. Anything else guarantees an off-by-one on the first emoji.
///
/// `matched_by` names the rule that fired, not just the family. It is what
/// turns "this pattern produces 40% of our false positives" into a query
/// instead of an afternoon of reading other people's messages.
model MessageRedaction {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  message_id String   @db.Uuid

  start_offset Int
  end_offset   Int
  category     RedactionCategory
  matched_by   String

  message ProfileMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id], name: "idx_message_redaction_message")
  @@index([category], name: "idx_message_redaction_category")
  @@map("message_redactions")
}

/// "This was not a phone number" — a sender contesting a redaction.
///
/// NOT a Claim, although claims are already this product's reporting channel. A
/// claim opens a kanban card and commits support's response time; the value
/// here is not handling one case but ACCUMULATING A CORPUS of false positives
/// to tune the patterns against. A claim thread cannot be aggregated; this
/// joined to `matched_by` is one query. If a report turns out to be a real
/// dispute, support opens a claim by hand — that is already their job.
model RedactionReport {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  message_id  String   @db.Uuid
  reporter_id String   @db.Uuid

  note String? @db.Text

  reviewed_at DateTime?
  reviewed_by String?   @db.Uuid
  /// True once a human agrees the detection was wrong. Null while unreviewed,
  /// so "pending" and "rejected" are not the same value.
  upheld      Boolean?

  message  ProfileMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  reporter Profile        @relation(fields: [reporter_id], references: [id], onDelete: Cascade)
  reviewer User?          @relation("RedactionReportReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  /// A report is a signal, not a conversation: the first one from an author
  /// stands, and a second tap is a no-op rather than another row in the queue.
  @@unique([message_id, reporter_id], map: "redaction_reports_message_reporter_key")
  @@index([reviewed_at], name: "idx_redaction_report_pending")
  @@map("redaction_reports")
}

/// Money sent from the payment gateway account (pawaPay) to a mobile-money
/// number, by an admin from Finance › Mobile Money. The ledger is debited
/// only once the gateway confirms the payout COMPLETED.
model MobileMoneyPayout {
  id                String       @id @default(uuid()) @db.Uuid
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  /// Generated by the admin's dialog. Submitting the same id again returns
  /// the payout already made instead of sending the money twice.
  client_request_id String       @unique @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("XAF")
  phone             String
  operator          String
  /// ISO 3166-1 alpha-3, from the operator.
  country           String
  note              String?
  status            PayoutStatus @default(PENDING)
  gateway           String
  /// The gateway's id for the payout (pawaPay payoutId).
  gateway_ref       String?      @unique
  gateway_tx_id     String?
  failure_reason    String?
  completed_at      DateTime?
  requested_by_id   String?      @db.Uuid
  requested_by      User?        @relation("PayoutRequestedBy", fields: [requested_by_id], references: [id], onDelete: SetNull)

  @@index([status], name: "idx_mm_payout_status")
  @@index([created_at], name: "idx_mm_payout_created")
  @@map("mobile_money_payouts")
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
}

/// How far a sign-up got. In order: each one is a screen of the onboarding the
/// person reached, so the stage of an unfinished attempt is where they stopped.
enum OnboardingStage {
  /// A WhatsApp code was sent and never entered.
  CODE_SENT
  /// The number checked out — they were on the profile type screen.
  PHONE_VERIFIED
  /// They reached the identity documents.
  DOCUMENTS
  /// They reached the last screen, the review before « Créer mon compte ».
  CONFIRMATION
  /// The account exists.
  COMPLETED
}

/// One sign-up attempt per phone number, from the first WhatsApp code to the
/// account — so the people who stopped halfway can be called and asked why.
///
/// Recorded best-effort: a failure to write here is logged and never refuses
/// or slows a sign-up. A row is not an account, and nothing reads it but the
/// back office.
model OnboardingAttempt {
  id                String          @id @default(uuid()) @db.Uuid
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  /// Normalised as the signup endpoints normalise it — the same key the
  /// verification and the account creation use. Null for a business sign-up,
  /// which proves an email instead: one of the two is always set (CHECK
  /// onboarding_attempts_contact).
  phone             String?         @unique
  /// The business sign-up's email, normalised the same way.
  email             String?         @unique
  /// 'whatsapp' or 'business' — how the sign-up was proven.
  entry             String          @default("whatsapp")
  first_name        String?
  last_name         String?
  profile_type      ProfileType?
  /// The furthest stage reached. Only ever moves forward, except when a number
  /// whose account was deleted starts over.
  stage             OnboardingStage @default(CODE_SENT)
  /// WhatsApp codes requested. Several with no verification usually means the
  /// code is not arriving.
  code_sends        Int             @default(1)
  started_at        DateTime        @default(now())
  last_activity_at  DateTime        @default(now())
  phone_verified_at DateTime?
  completed_at      DateTime?
  /// The account it became. A plain id, not a relation: the attempt outlives a
  /// deleted profile as a record of the sign-up.
  profile_id        String?         @db.Uuid
  /// Follow-up by the team: when someone reached out, who, and what was said.
  contacted_at      DateTime?
  contacted_by_id   String?         @db.Uuid
  contact_note      String?

  @@index([stage, last_activity_at], name: "idx_onboarding_attempt_stage_activity")
  @@index([started_at], name: "idx_onboarding_attempt_started")
  @@map("onboarding_attempts")
}

/// What an organisation is — asked at business sign-up, in everyday words.
/// Congo-Brazzaville categories; labels and required documents live in
/// src/modules/business/business-catalog.ts.
enum BusinessCategory {
  INDIVIDUAL_BUSINESS
  TPE
  PME
  LARGE_COMPANY
  STARTUP
  COOPERATIVE
  GIE
  ASSOCIATION
  NGO
  INTERNATIONAL_NGO
  FOUNDATION
  RELIGIOUS
  SCHOOL
  HIGHER_EDUCATION
  TRAINING_CENTER
  HEALTH
  PUBLIC_ADMINISTRATION
  PUBLIC_ENTERPRISE
  INTERNATIONAL_ORG
  OTHER
}

/// The OHADA (or other) legal form, when the organisation has one.
enum BusinessLegalForm {
  EI
  SARL
  SARLU
  SA
  SAS
  SASU
  SNC
  SCS
  GIE
  SCOOPS
  COOP_CA
  BRANCH
  ASSOCIATION
  FOUNDATION
  PUBLIC_ENTITY
  OTHER
}

/// The organisation's papers, as issued in Congo-Brazzaville.
enum BusinessDocumentType {
  RCCM
  NIU
  STATUTS
  PATENTE
  CNSS
  SCIEN_SCIET
  RECEPISSE
  AGREMENT
  AUTORISATION_OUVERTURE
  ARRETE
  MANDATE
  OTHER
}

/// The organisation behind a business profile (`Profile.is_business`). One per
/// profile. Reviewed by an admin on its documents — a business has no personal
/// KYC; approving the business is what verifies and activates the profile.
model Business {
  id                  String             @id @default(uuid()) @db.Uuid
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  profile_id          String             @unique @db.Uuid
  /// The private link of its interview calendar. Kept as is, not hashed: the
  /// business must be able to see it again to add it to another agenda; it
  /// only reads the interviews, and replacing it cuts the old one off.
  calendar_token      String?            @unique
  /// Raison sociale.
  name                String
  category            BusinessCategory
  legal_form          BusinessLegalForm?
  /// Headcount bracket: "1-5", "6-20", "21-100", "100+".
  size                String?
  /// RCCM number.
  registration_number String?
  /// NIU (tax).
  tax_id              String?
  /// SCIEN / SCIET (CNSEE).
  statistical_id      String?
  address             String
  country_code        String?            @db.VarChar(2)
  city                String?
  email               String?
  phone               String?
  website             String?
  description         String?            @db.Text
  verification_status VerificationStatus @default(PENDING)
  verified_at         DateTime?
  verified_by         String?            @db.Uuid
  rejection_reason    String?
  deleted_at          DateTime?          @db.Timestamptz

  profile       Profile                @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  documents     BusinessDocument[]
  subscriptions BusinessSubscription[]
  cv_screenings CvScreening[]
  interviews    Interview[]

  @@index([verification_status], name: "idx_business_verification_status")
  @@index([category], name: "idx_business_category")
  @@index([deleted_at], name: "idx_business_deleted_at")
  @@map("businesses")
}

/// One of a business's papers, in the private KYC bucket like `KycDocument`.
model BusinessDocument {
  id                  String               @id @default(uuid()) @db.Uuid
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  business_id         String               @db.Uuid
  document_type       BusinessDocumentType
  storage_key         String
  file_name           String?
  mime_type           String?
  verification_status VerificationStatus   @default(PENDING)
  verified_at         DateTime?
  verified_by         String?              @db.Uuid
  rejection_reason    String?
  /// The earlier version this file was sent to replace (a refused paper
  /// re-uploaded by the business). The old row stays, superseded, as history.
  replaces_id         String?              @unique @db.Uuid
  /// Set when a newer version replaced this one; current papers have none.
  superseded_at       DateTime?            @db.Timestamptz

  business     Business          @relation(fields: [business_id], references: [id], onDelete: Cascade)
  replaces     BusinessDocument? @relation("BusinessDocumentVersions", fields: [replaces_id], references: [id], onDelete: SetNull)
  replaced_by  BusinessDocument? @relation("BusinessDocumentVersions")

  @@index([business_id], name: "idx_business_document_business")
  @@map("business_documents")
}

enum BusinessSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BusinessBillingPeriod {
  TRIAL
  MONTHLY
  ANNUAL
}

/// A business plan, edited in admin: prices, quotas and what it includes.
/// Never hard-coded — the catalog is this table.
model BusinessPlan {
  id                    String   @id @default(uuid()) @db.Uuid
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  code                  String   @unique
  name                  String
  description           String?  @db.Text
  monthly_price_fcfa    Int
  annual_price_fcfa     Int
  /// Contact unlocks covered per period (employer side). Null: unlimited.
  unlocks_per_period    Int?
  /// Job offers published per period. Null: unlimited.
  active_offers_limit   Int?
  includes_preselection Boolean  @default(false)
  includes_field_agents Boolean  @default(false)
  priority_visibility   Boolean  @default(false)
  /// CVs the AI screening reads per period. Null: unlimited; 0: not included.
  cv_screenings_per_period Int?  @default(0)
  /// CVs in one screening (one upload), 5 at most.
  cv_batch_max          Int      @default(5)
  /// Largest CV file accepted, in MB.
  cv_file_max_mb        Int      @default(5)
  /// Days a screening keeps its files and contact details before the purge.
  cv_retention_days     Int      @default(30)
  /// Questions a business may ask about one analysed CV (its chat).
  cv_chat_questions     Int      @default(20)
  /// Offers the AI writes per period (« Rédiger avec l'IA »). Null: unlimited; 0: not included.
  offer_drafts_per_period Int?   @default(20)
  is_active             Boolean  @default(true)
  sort_order            Int      @default(0)
  /// Deleted by an admin: hidden everywhere, kept for the periods and payments that point to it.
  deleted_at            DateTime?

  subscriptions BusinessSubscription[]

  @@map("business_plans")
}

/// One period of a plan, bought, granted or given as the trial. At most one
/// TRIAL/ACTIVE row covers a moment; a renewal bought early starts when the
/// running one ends. One trial per business, ever (partial unique index).
model BusinessSubscription {
  id                  String                     @id @default(uuid()) @db.Uuid
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt
  business_id         String                     @db.Uuid
  plan_id             String                     @db.Uuid
  status              BusinessSubscriptionStatus
  billing_period      BusinessBillingPeriod
  starts_at           DateTime                   @db.Timestamptz
  ends_at             DateTime                   @db.Timestamptz
  unlocks_used        Int                        @default(0)
  /// CVs read by the AI screening this period (unreadable ones given back).
  cv_screened         Int                        @default(0)
  /// Offers the AI wrote for this period.
  offer_drafts_used   Int                        @default(0)
  /// Offers published (or republished) during this period.
  offers_published    Int                        @default(0)
  payment_request_id  String?                    @unique @db.Uuid
  /// The admin who granted or cancelled it by hand.
  granted_by          String?                    @db.Uuid
  reminded_at         DateTime?                  @db.Timestamptz
  /// Set once the expiry has been handled (status, offers, messages).
  expired_notified_at DateTime?                  @db.Timestamptz

  business Business             @relation(fields: [business_id], references: [id], onDelete: Cascade)
  plan     BusinessPlan         @relation(fields: [plan_id], references: [id])
  usages   BusinessQuotaUsage[]
  cv_screenings CvScreening[]

  @@index([business_id, ends_at], name: "idx_business_subscription_business_end")
  @@index([status, ends_at], name: "idx_business_subscription_status_end")
  @@map("business_subscriptions")
}

enum CvScreeningStatus {
  PROCESSING
  DONE
}

enum CvScreeningResumeStatus {
  QUEUED
  SCORED
  /// Nothing readable in it (empty, corrupt, not a CV): not counted.
  UNREADABLE
  /// Every model failed on it: not counted.
  FAILED
}

/// CVs a business had the AI read and rank against one job: one of its offers,
/// or a job described by hand. The job text is a snapshot, so editing the
/// offer later does not change what the scores were measured against.
model CvScreening {
  id              String            @id @default(uuid()) @db.Uuid
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  business_id     String            @db.Uuid
  /// The period whose « CV inclus » paid for it; unreadable CVs go back to it.
  subscription_id String?           @db.Uuid
  offer_id        String?           @db.Uuid
  job_title       String
  job_text        String            @db.Text
  status          CvScreeningStatus @default(PROCESSING)
  /// The purge date: files and contact details go, scores stay.
  expires_at      DateTime          @db.Timestamptz
  purged_at       DateTime?         @db.Timestamptz

  business     Business              @relation(fields: [business_id], references: [id], onDelete: Cascade)
  subscription BusinessSubscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  offer        JobOffer?             @relation(fields: [offer_id], references: [id], onDelete: SetNull)
  resumes      CvScreeningResume[]
  comparisons  CvComparison[]

  @@index([business_id, created_at], name: "idx_cv_screening_business_created")
  @@index([expires_at], name: "idx_cv_screening_expires")
  @@map("cv_screenings")
}

/// One CV of a screening, in the private KYC bucket, and what the AI made of it.
model CvScreeningResume {
  id             String                  @id @default(uuid()) @db.Uuid
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt
  screening_id   String                  @db.Uuid
  file_name      String
  mime_type      String
  size_bytes     Int
  /// Null once purged.
  storage_key    String?
  storage_bucket String?
  /// The CV's text, read once, for its chat; null for a scan, and once purged.
  cv_text        String?                 @db.Text
  status         CvScreeningResumeStatus @default(QUEUED)
  /// 0–100 against the job.
  score          Int?
  /// Sub-scores (skills, experience, training, location, languages), 0–100.
  criteria       Json?
  summary        String?                 @db.Text
  strengths      String[]                @default([])
  gaps           String[]                @default([])
  /// What the CV says of the person: name, city, years of experience, and
  /// email/phone until the purge.
  candidate      Json?
  error          String?

  screening CvScreening          @relation(fields: [screening_id], references: [id], onDelete: Cascade)
  messages  CvResumeMessage[]
  interviews Interview[]

  @@index([screening_id], name: "idx_cv_screening_resume_screening")
  @@map("cv_screening_resumes")
}

enum CvChatRole {
  USER
  ASSISTANT
}

/// The business's conversation with the AI about one analysed CV. Deleted
/// with the CV's files at the end of the retention: it quotes the CV.
model CvResumeMessage {
  id         String     @id @default(uuid()) @db.Uuid
  created_at DateTime   @default(now())
  resume_id  String     @db.Uuid
  role       CvChatRole
  content    String     @db.Text

  resume CvScreeningResume @relation(fields: [resume_id], references: [id], onDelete: Cascade)

  @@index([resume_id, created_at], name: "idx_cv_resume_message_resume_created")
  @@map("cv_resume_messages")
}

/// A conversation comparing several CVs of one screening. One per selection:
/// choosing the same CVs again reopens it. Its messages go with the files at
/// the end of the retention (they quote the CVs).
model CvComparison {
  id           String   @id @default(uuid()) @db.Uuid
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  screening_id String   @db.Uuid
  /// The CVs compared, sorted.
  resume_ids   String[]
  /// `resume_ids` joined: what makes a selection the same one.
  selection    String

  screening CvScreening           @relation(fields: [screening_id], references: [id], onDelete: Cascade)
  messages  CvComparisonMessage[]

  @@unique([screening_id, selection])
  @@map("cv_comparisons")
}

model CvComparisonMessage {
  id            String     @id @default(uuid()) @db.Uuid
  created_at    DateTime   @default(now())
  comparison_id String     @db.Uuid
  role          CvChatRole
  content       String     @db.Text

  comparison CvComparison @relation(fields: [comparison_id], references: [id], onDelete: Cascade)

  @@index([comparison_id, created_at], name: "idx_cv_comparison_message_comparison_created")
  @@map("cv_comparison_messages")
}

enum InterviewMode {
  IN_PERSON
  PHONE
  VIDEO
}

enum InterviewStatus {
  /// Sent; the candidate has not answered.
  PENDING
  CONFIRMED
  DECLINED
  /// The candidate asked for another time (their note says which).
  RESCHEDULE_REQUESTED
  CANCELLED
}

/// An interview a business proposes to a candidate: one whose CV it analysed
/// (reached by e-mail) or one who applied to its offer (e-mail and in-app).
/// The candidate answers through a private link (`token_hash` keeps only the
/// hash of it); the business sees the answer live.
model Interview {
  id               String          @id @default(uuid()) @db.Uuid
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  business_id      String          @db.Uuid
  /// Exactly one of the two: where the candidate comes from.
  cv_resume_id     String?         @db.Uuid
  application_id   String?         @db.Uuid
  offer_id         String?         @db.Uuid
  job_title        String
  candidate_name   String
  /// Where the invitation goes. For an applicant it is read from their
  /// profile at send time and never shown to the business through this row.
  candidate_email  String?
  starts_at        DateTime        @db.Timestamptz
  duration_minutes Int
  mode             InterviewMode
  /// The address, or the video link; the number to call for a phone interview.
  location         String?
  message          String?         @db.Text
  status           InterviewStatus @default(PENDING)
  /// The candidate's words with their answer (another time, a question…).
  response_note    String?         @db.Text
  responded_at     DateTime?       @db.Timestamptz
  token_hash       String          @unique
  /// The reminder sent the day before, to both sides.
  reminded_at      DateTime?       @db.Timestamptz

  business  Business           @relation(fields: [business_id], references: [id], onDelete: Cascade)
  cv_resume CvScreeningResume? @relation(fields: [cv_resume_id], references: [id], onDelete: SetNull)
  application Application?     @relation(fields: [application_id], references: [id], onDelete: SetNull)
  offer     JobOffer?          @relation(fields: [offer_id], references: [id], onDelete: SetNull)

  @@index([business_id, starts_at], name: "idx_interview_business_starts")
  @@index([status, starts_at], name: "idx_interview_status_starts")
  @@index([cv_resume_id], name: "idx_interview_cv_resume")
  @@index([application_id], name: "idx_interview_application")
  @@map("interviews")
}

/// A worker a business keeps for later — its talent pool. Private to the
/// business: a note and tags only it reads. One row per business and worker.
model BusinessTalent {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  /// The business's profile (the employer side), as on every offer.
  employer_id String   @db.Uuid
  worker_id   String   @db.Uuid
  note        String?  @db.Text
  tags        String[] @default([])

  employer Profile @relation("BusinessTalentEmployer", fields: [employer_id], references: [id], onDelete: Cascade)
  worker   Profile @relation("BusinessTalentWorker", fields: [worker_id], references: [id], onDelete: Cascade)

  @@unique([employer_id, worker_id])
  @@index([employer_id], name: "idx_business_talent_employer")
  @@map("business_talents")
}

/// A contact unlock covered by a subscription's quota. Released (and the unit
/// given back) when the unlock expires or is cancelled.
model BusinessQuotaUsage {
  id                        String    @id @default(uuid()) @db.Uuid
  created_at                DateTime  @default(now())
  subscription_id           String    @db.Uuid
  /// The unit covered one of the two: a mission unlock (its attempt), or a
  /// direct unlock from the business's search (its contact record).
  contact_unlock_attempt_id String?   @unique @db.Uuid
  contact_record_id         String?   @unique @db.Uuid
  released_at               DateTime? @db.Timestamptz

  subscription BusinessSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id], name: "idx_business_quota_usage_subscription")
  @@map("business_quota_usages")
}

/// How well an applicant to a business's offer fits it: scored by the AI from
/// their Rabotka profile (no CV), reliability computed. Made once, in the background.
model ApplicationAssessment {
  id             String   @id @default(uuid()) @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  application_id String   @unique @db.Uuid
  /// 0–100; null when it could not be assessed.
  score          Int?
  /// trade, experience, location (AI), reliability (computed), 0–100.
  criteria       Json?
  summary        String?  @db.Text
  strengths      String[] @default([])
  gaps           String[] @default([])
  /// The model never answered usably: not tried again.
  failed         Boolean  @default(false)

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("application_assessments")
}
