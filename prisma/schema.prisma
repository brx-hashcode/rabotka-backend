generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProfileType {
  WORKER
  EMPLOYER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// ADMIN / MANAGER / MODERATOR / SUPER_ADMIN form a hierarchy (see
/// ROLE_HIERARCHY in roles.guard.ts). FINANCE and SUPPORT are *lateral*: they
/// sit outside that ladder and are granted an explicit allowlist of areas
/// instead (see LATERAL_ACCESS in lateral-access.ts).
enum UserRole {
  ADMIN
  MANAGER
  MODERATOR
  SUPER_ADMIN
  FINANCE
  SUPPORT
}

enum StorageProvider {
  S3
  LOCAL
  CLOUDINARY
  VERCEL_BLOB
  CLOUDFLARE
}

enum BotPlatform {
  WHATSAPP
  EMAIL
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
  IN_APP
  ALL
}

/// How often an EventSeries repeats. Deliberately no INTERVAL companion: the
/// form offers presets only, and RFC 5545 treats a missing INTERVAL as 1, so
/// these map straight onto RRULE FREQ values.
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Lifecycle of one outbound WhatsApp message.
///
/// ORDERED. Meta batches status webhooks and does not guarantee their order, so
/// a `sent` can land after a `read`; `applyStatus` only ever moves a row
/// forward through this list. FAILED is terminal and outranks everything.
enum WhatsappDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  /// An INBOUND row: someone wrote to us. Not a delivery state, so it sits
  /// outside the outbound rates entirely.
  RECEIVED
}

enum ConversationStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  BANNED
}

/// What put an account in SUSPENDED, so each way out lifts only its own kind:
/// paying the penalties reactivates an UNPAID_PENALTIES suspension, never one
/// an admin or repeated cancellations imposed.
enum SuspensionSource {
  ADMIN
  UNPAID_PENALTIES
  REPEATED_CANCELLATIONS
}

enum DocumentType {
  IDENTITY_CARD
  PASSPORT
  DRIVER_LICENSE
  NIU_CARD
}

/// Which file of a KYC submission a row holds: DOCUMENT is the FRONT of the
/// identity document, DOCUMENT_BACK the back, SELFIE the applicant holding it.
/// One row per category per profile, enforced by KycDocument's
/// unique([profile_id, document_category]).
///
/// PASSPORT submissions have no DOCUMENT_BACK row -- a passport carries all its
/// data on the photo page. Every other DocumentType requires all three.
///
/// Declaration order is the sort order (hence the matching `AFTER 'DOCUMENT'`
/// in the migration that added it), so `orderBy: { document_category: 'asc' }`
/// yields front -> back -> selfie for the admin review grid.
enum KycDocumentCategory {
  DOCUMENT
  DOCUMENT_BACK
  SELFIE
}

enum JobOfferStatus {
  ACTIVE
  PARTIALLY_FILLED
  FILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  VIEWED
  WAITING_PAYMENT
  ACCEPTED
  REJECTED
  CANCELLED
  STARTED
  END
}

enum BillingStatus {
  CLEAR
  PENDING_PAYMENT
  BLOCKED
}

enum AssignmentStatus {
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED_BY_WORKER
  CANCELLED_BY_EMPLOYER
}

enum CancelledBy {
  WORKER
  EMPLOYER
}

/// Who ended an application.
///
/// Separate from `CancelledBy` (which types `Assignment.cancelled_by`) because
/// of SYSTEM: no assignment writer will ever produce that value, and widening
/// the other enum would admit it everywhere for nothing.
enum ApplicationCancelledBy {
  WORKER
  EMPLOYER
  /// The platform's own timeouts — the offer expiring, an unlock payment window
  /// lapsing. The worker did nothing, so they are not treated as having walked
  /// away and may apply again.
  SYSTEM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  WALLET
  OTHER
}

enum PaymentType {
  REGISTRATION
  JOB_POSTING
  PENALTY
  CONTACT_UNLOCK
  WALLET_TOP_UP
  BUSINESS_SUBSCRIPTION
}

enum PaymentFlow {
  HOURLY
  DAILY
  MONTHLY
  /// A fixed price for the whole job ("forfait") — a repair, a move, an
  /// outfit to sew. Most missions are paid this way, and the three time-based
  /// flows left an employer with a fixed price nothing true to pick.
  TASK
}

/// What kind of engagement an offer is.
///
/// Named EmploymentType rather than ContractType because `Contract` already
/// means the generated PDF agreement attached to an application — two meanings
/// for one word is how PaymentFlow/payment_flow drifted.
///
/// MISSION is the one-off gig Rabotka started with and remains the default, so
/// every offer that predates this enum keeps exactly its current semantics. It
/// is also the only type that requires a date, and the only one that can be
/// completed: a CDI is never "terminated" the way a gig is.
enum EmploymentType {
  MISSION
  CDD
  CDI
  STAGE
}

enum WalletOwnerType {
  SYSTEM
  USER
  PROFILE
  MOBILE_MONEY
}

enum WalletTransactionType {
  CREDIT_PENALTY
  CREDIT_COMMISSION
  CREDIT_REGISTRATION
  CREDIT_JOB_POSTING
  WELCOME_CREDIT
  MANUAL_CREDIT
  CONTACT_UNLOCK_DEBIT
  CONTACT_UNLOCK_PAYMENT
  CONTACT_UNLOCK_CREDIT_CONVERSION
  PENALTY_DEBIT
  MOBILE_MONEY_CREDIT
  MOBILE_MONEY_WITHDRAWAL
  TOP_UP_CREDIT
  REFERRAL_CREDIT
}

/// Lifecycle of one referral. Four of the five states mean "no money moved",
/// which is why this is a status and not a boolean: an admin asked "why wasn't
/// my friend's parrainage paid?" needs to distinguish "not yet" from "referrer
/// unverified" from "over the cap" from "the payment was too small to fund it".
enum ReferralStatus {
  /// Relationship recorded at signup. The referee has not yet made a
  /// qualifying payment.
  PENDING
  /// The referee paid, but the referrer was not ACTIVE+VERIFIED at that
  /// moment. Settles later, when their KYC is approved.
  QUALIFIED_ON_HOLD
  /// Both sides credited. Terminal.
  REWARDED
  /// The referee paid, but nothing was owed: the referrer is over the cap, or
  /// the payout would have exceeded the payment that triggered it. Terminal,
  /// and deliberately distinct from FORFEITED — nobody did anything wrong.
  CAPPED
  /// Terminal non-payment: the referrer was deleted or banned, or the hold
  /// expired before their KYC was approved.
  FORFEITED
}

enum ReferralSource {
  LINK
  MANUAL_CODE
  BOT
  ADMIN
}

enum ContactUnlockStatus {
  PENDING_BOTH
  PENDING_EMPLOYER
  PENDING_WORKER
  UNLOCKED
  EXPIRED
  CONVERTED_TO_CREDIT
}

enum PaymentRequestStatus {
  PENDING
  PROCESSING
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentRequestType {
  PENALTY_BATCH
  PENALTY_RESOLUTION
  CONTACT_UNLOCK
  RECOMMENDATION_CONTACT
  WALLET_TOP_UP
  /// A period of a business plan (BusinessSubscription).
  BUSINESS_SUBSCRIPTION
}

enum ClaimStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ConfigCategory {
  TWILIO
  FEES
  MATCHING
  CONTACT
  STORAGE
  GENERAL
  /// Field agents: phone-reveal cap, claim and invitation lifetimes.
  AGENT
}

enum InteractionActor {
  WORKER
  EMPLOYER
}

enum InteractionObject {
  JOB_OFFER
  WORKER_PROFILE
  EMPLOYER_PROFILE
  PORTFOLIO
  SEARCH
  CATEGORY
}

enum InteractionSource {
  WEB
  BOT
  MOBILE
  SERVER
  BACKFILL
}

enum InteractionKind {
  // Passive / browsing
  IMPRESSION_BATCH
  VIEW
  PROFILE_VIEW
  PORTFOLIO_VIEW
  // Explicit intent
  SEARCH
  SEARCH_CLICK
  SAVE
  UNSAVE
  // An employer publishing an offer. Their most deliberate statement of which
  // sector they hire in — repeated, and costly to make — where the categories
  // ticked once at signup are neither.
  PUBLISH
  // Commitment
  APPLY
  APPLY_CANCEL
  ACCEPT
  REJECT
  COMPLETE
  NO_SHOW
  // Outcome quality
  RATE_POSITIVE
  RATE_NEGATIVE
  // Paid intent — the strongest employer signal there is
  CONTACT_UNLOCK
  CONTACT_PAID
  // Explicit negatives
  SKIP
  DISLIKE
  // Bookkeeping for evaluation (what we served, so CTR is computable)
  RECOMMENDATION_SERVED
}

/**
 * How an employer's REJECTED decision came about.
 * Without this, a bulk auto-reject (offer filled up, so everyone still pending is
 * closed out) is indistinguishable from an employer actively turning someone
 * down. The recommender reads repeated rejections in a category as "this worker
 * doesn't want this kind of work" — so losing two races would ban a worker from
 * their own trade. Only EMPLOYER rejections may count as a negative signal.
 */
enum RejectionSource {
  EMPLOYER
  AUTO_FILL
}

/**
 * Which way a rating points. Previously only derivable by joining assignments.
 */
enum RatingDirection {
  EMPLOYER_TO_WORKER
  WORKER_TO_EMPLOYER
}

/// Whether an agent may use the agent app. Checked uncached on every request
/// by AgentAuthGuard, so a suspension takes effect on the next call rather
/// than when the token expires.
enum AgentStatus {
  ACTIVE
  SUSPENDED
  /// Terminal: the agency relationship is over. Kept as a row, never deleted,
  /// because placements and earnings will point at it.
  REVOKED
}

model SystemConfig {
  id         String         @id @default(uuid()) @db.Uuid
  key        String         @unique
  value      String         @db.Text
  category   ConfigCategory
  label      String
  is_secret  Boolean        @default(false)
  updated_at DateTime       @updatedAt
  updated_by String?        @db.Uuid

  @@index([category], name: "idx_system_config_category")
  @@map("system_configs")
}

model Profile {
  id                                String             @id @default(uuid()) @db.Uuid
  created_at                        DateTime           @default(now())
  updated_at                        DateTime           @updatedAt
  first_name                        String
  last_name                         String
  phone                             String             @unique
  /// A second number to be reached on, when the WhatsApp number is not one the
  /// person actually answers calls on — a shared handset, a business line, a
  /// number that only runs WhatsApp over data.
  ///
  /// Deliberately NOT unique and deliberately nullable, unlike `phone`. This is
  /// never a login identity: nothing authenticates against it, no OTP is sent
  /// to it, and a household or a company switchboard shared by two profiles
  /// must not make the second signup fail. Optional at every layer for the same
  /// reason — most people have only one number.
  direct_phone                      String?
  /// Optional: Rabotka onboards the informal sector, where most workers have a
  /// phone but no email address. `phone` is the real identity — onboarding is
  /// WhatsApp-first and signup proves the number. Nullable rather than blank:
  /// the unique index treats '' as a value, so two emailless profiles holding
  /// '' would collide. Automated mail to a profile without one is skipped
  /// silently in `MailService.sendMail`.
  email                             String?            @unique
  address                           String
  /// ISO 3166-1 alpha-2. What the ranker and the coming filters compare —
  /// stable and case-safe, unlike the display name beside it.
  country_code                      String?            @db.VarChar(2)
  /// Denormalised so admin and the profile page can render a country without
  /// carrying the reference list.
  country_name                      String?
  city                              String?
  latitude                          Float?
  longitude                         Float?
  description                       String             @db.Text
  profile_type                      ProfileType
  category_id                       String?            @db.Uuid
  status                            AccountStatus      @default(PENDING_ACTIVATION)
  billing_status                    BillingStatus      @default(CLEAR)
  reliability_score                 Int?               @default(100)
  rating_avg                        Float?
  rating_count                      Int                @default(0)
  whatsapp_connected                Boolean            @default(false)
  whatsapp_activation_bonus_granted Boolean            @default(false)
  /// This employer represents an organisation — see `business`. Always an
  /// EMPLOYER: enforced by the CHECK constraint profiles_business_is_employer
  /// (migration 20261023100000_business_accounts), which Prisma cannot model.
  is_business                       Boolean            @default(false)

  /// While this is in the future, the bot says NOTHING to this profile: no
  /// reply to an inbound message, no scheduled reminder or nudge. An admin who
  /// has taken the conversation over is not talked over by a robot.
  ///
  /// A deadline rather than a boolean, so a forgotten toggle heals itself. Every
  /// admin message pushes it out again, so an active handover stays paused for
  /// as long as it is active, and a profile nobody came back to is returned to
  /// the bot instead of being silently cut off from it forever.
  bot_paused_until                  DateTime?          @db.Timestamptz
  payment_link                      String?
  payment_link_expires_at           DateTime?
  verification_status               VerificationStatus @default(PENDING)
  verified_by                       String?            @db.Uuid
  verified_at                       DateTime?
  rejection_reason                  String?
  /// Admin note from the latest KYC verify action (approve or reject).
  kyc_verification_note             String?            @db.Text
  /// Why the account was suspended. Cleared when it leaves SUSPENDED, so it
  /// always describes the CURRENT suspension rather than the last one ever.
  suspension_reason                 String?            @db.Text
  suspended_at                      DateTime?
  /// Why it is suspended, as a kind — see SuspensionSource. NULL for
  /// suspensions that predate the column, and whenever not SUSPENDED.
  suspension_source                 SuspensionSource?
  read_and_approved_policies        Boolean            @default(false)
  first_login                       Boolean            @default(true)
  /// First time the account became usable. Distinct from `last_login_at`:
  /// activating mints no session, so it is not a sign-in. Written once, by
  /// whichever activation path gets there first, and never overwritten.
  activated_at                      DateTime?
  /// Last authenticated interaction: web OTP, mobile OTP, or any bot message —
  /// a WhatsApp message arrives from a verified number, which is the same proof
  /// the OTP flow establishes. Refresh-token rotation does NOT move it.
  /// Throttled by `LOGIN_STAMP_THROTTLE_MS`, so it is accurate to the minute
  /// rather than the message.
  last_login_at                     DateTime?
  /// When this profile last wrote to us ON WHATSAPP — the start of Meta's 24h
  /// customer-service window, inside which free-form text is allowed and free.
  ///
  /// A denormalisation of "newest INBOUND Message with platform WHATSAPP",
  /// which `WhatsAppService.saveMessage` keeps in step. It exists because the
  /// window has to be READABLE IN BULK: a fan-out that decides per recipient
  /// between a billed template and a free message cannot afford one query per
  /// person, which is why no fan-out checked the window at all before.
  ///
  /// NULL means the profile has never messaged us, i.e. the window is closed.
  /// That is the common case, not an edge case — most people sign up on the web
  /// and never write to the bot. Backfilled from `messages` at migration time,
  /// so a NULL here is a fact rather than a gap.
  last_inbound_at                   DateTime?
  /// When this profile asked to stop receiving non-transactional messages, by
  /// replying STOP on WhatsApp or from the back office. Null means opted in.
  ///
  /// Scope is deliberately narrow: announcements and job suggestions. Anything
  /// that concerns something they did — an application, a payment, a penalty,
  /// an OTP — keeps arriving, because silencing those would break the product
  /// rather than respect a preference.
  marketing_opt_out_at              DateTime?

  avatar_url        String?
  vector_indexed_at DateTime?
  portfolio_slug    String?   @unique

  /// Short, human-dictatable parrainage code. Minted lazily on first request
  /// like `portfolio_slug` — see ReferralService.ensureReferralCode — so NULL
  /// means "never asked for one", not "not eligible". There is deliberately no
  /// `referred_by_id` beside it: Referral.referee_id is unique and answers that
  /// in one place, and a second copy is a second thing that can disagree.
  referral_code String? @unique

  category   JobCategory?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  categories ProfileCategory[]

  payment_requests                PaymentRequest[]
  kyc_documents                   KycDocument[]
  business                        Business?
  talents_kept                    BusinessTalent[]       @relation("BusinessTalentEmployer")
  kept_by_businesses              BusinessTalent[]       @relation("BusinessTalentWorker")
  kyc_verification_images         KycVerificationImage[]
  applications                    Application[]
  job_offers                      JobOffer[]
  penalties                       Penalty[]
  payments                        Payment[]
  conversations                   Conversation[]
  messages                        Message[]
  vova_memory                     VovaProfileMemory?
  whatsapp_messages               WhatsappMessage[]
  whatsapp_contacts               WhatsappContact[]
  logs                            Log[]
  files                           File[]
  wallets                         Wallet[]
  assignments                     Assignment[]
  verification_tokens             VerificationToken[]
  claims                          Claim[]                       @relation("ClaimProfile")
  unlock_attempts_as_worker       ContactUnlockAttempt[]        @relation("UnlockWorker")
  unlock_attempts_as_employer     ContactUnlockAttempt[]        @relation("UnlockEmployer")
  contact_records_as_worker       ContactRecord[]               @relation("ContactRecordWorker")
  contact_records_as_employer     ContactRecord[]               @relation("ContactRecordEmployer")
  claims_created                  Claim[]                       @relation("ClaimCreatedByProfile")
  claim_comments                  ClaimComment[]                @relation("ClaimCommentProfile")
  events                          Event[]                       @relation("EventProfiles")
  profile_platform_document_links ProfilePlatformDocumentLink[]
  invoices                        Invoice[]
  ad_delivery_logs                AdDeliveryLog[]
  ratings_given                   Rating[]                      @relation("RatingRater")
  feedback                        Feedback[]
  ratings_received                Rating[]                      @relation("RatingRatee")
  portfolio_items                 PortfolioItem[]
  saved_jobs                      SavedJob[]
  interaction_events              InteractionEvent[]            @relation("InteractionActor")
  interaction_profile             InteractionProfile?
  referrals_made                  Referral[]                    @relation("ReferralReferrer")
  agent_leads                     AgentLead[]
  agent_phone_reveals             AgentPhoneReveal[]
  referral_received               Referral?                     @relation("ReferralReferee")
  oauth_authorizations            OAuthAuthorization[]
  identity_checks                 IdentityCheck[]
  notifications_received          ProfileNotification[]         @relation("ProfileNotificationRecipient")
  broadcast_deliveries            BroadcastRecipient[]
  notifications_triggered         ProfileNotification[]         @relation("ProfileNotificationActor")
  push_subscriptions              ProfilePushSubscription[]
  conversations_as_worker         ProfileConversation[]         @relation("ConversationWorker")
  conversations_as_employer       ProfileConversation[]         @relation("ConversationEmployer")
  messages_sent                   ProfileMessage[]
  redaction_reports_filed         RedactionReport[]
  deleted_at                      DateTime?                     @db.Timestamptz

  @@index([email], name: "idx_profile_email")
  @@index([phone], name: "idx_profile_phone")
  @@index([status], name: "idx_profile_status")
  @@index([profile_type], name: "idx_profile_type")
  @@index([reliability_score], name: "idx_profile_reliability")
  @@index([category_id], name: "idx_profile_category")
  @@index([deleted_at], name: "idx_profile_deleted_at")
  @@index([is_business], name: "idx_profile_is_business")
  @@index([country_code, city], name: "idx_profile_country_city")
  @@index([last_inbound_at(sort: Desc)], name: "idx_profile_last_inbound")
  @@map("profiles")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  first_name      String
  last_name       String
  email           String    @unique
  role            UserRole  @default(ADMIN)
  is_active       Boolean   @default(true)
  last_login_at   DateTime?
  phone_paired_at DateTime?
  phone_name      String?
  totp_secret     String?
  totp_enabled    Boolean   @default(false)
  /// In the KYC verification group: emailed each time a profile is created,
  /// to review its documents. Picked person by person, never implied by role;
  /// only roles that can verify KYC may hold it (`KYC_REVIEWER_ROLES`).
  kyc_reviewer    Boolean   @default(false)

  files                  File[]
  logs                   Log[]
  wallets                Wallet[]
  sent_messages          Message[]
  sent_whatsapp_messages WhatsappMessage[]
  claims_assigned        Claim[]           @relation("ClaimAssignedUser")
  claims_assigned_by     Claim[]           @relation("ClaimAssignedByUser")
  claims_created         Claim[]           @relation("ClaimCreatedByUser")
  claim_comments         ClaimComment[]    @relation("ClaimCommentUser")
  events_created         Event[]           @relation("EventCreatedBy")
  events                 Event[]           @relation("EventAssignedUsers")
  deleted_at             DateTime?         @db.Timestamptz

  chat_participants          ChatParticipant[]
  chat_messages              ChatMessage[]
  chat_conversations         ChatConversation[] @relation("ChatConversationCreatedBy")
  oauth_apps_created         OAuthApp[]         @relation("OAuthAppCreatedBy")
  broadcasts_created         Broadcast[]
  redaction_reports_reviewed RedactionReport[]  @relation("RedactionReportReviewer")

  @@index([email], name: "idx_user_email")
  @@index([role], name: "idx_user_role")
  @@index([deleted_at], name: "idx_user_deleted_at")
  @@map("users")
  payouts_requested MobileMoneyPayout[] @relation("PayoutRequestedBy")
}

/// A field agent: someone who calls workers on Rabotka's behalf and gets them
/// onto jobs, from the separate agent app.
///
/// A third identity, beside Profile (end users) and User (staff), on purpose.
/// The same person may also hold a worker or employer Profile, and the two are
/// independent accounts — an agent is not a capability of a profile. They meet
/// only through the phone number, which is what conflict-of-interest checks
/// compare.
///
/// Created by an admin only; there is no signup. Login is email + a one-time
/// code sent by email.
model Agent {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  first_name String
  last_name  String
  /// The login identity: the OTP is sent here. Lowercased and trimmed on write.
  email      String   @unique
  /// E.164, normalised with `toE164` on write — unlike `profiles.phone`, which
  /// is stored as typed. Not a login identity: it is what conflict-of-interest
  /// checks compare against profiles, and the default Mobile Money number.
  phone      String   @unique

  /// The identity document the admin checked. The number is normalised
  /// (uppercased, separators removed) and unique per type, so the same person
  /// cannot be created twice. Never returned to the agent app.
  id_document_type   DocumentType
  id_document_number String

  /// Public bucket, like `Profile.avatar_url`. The key is kept so a replaced
  /// avatar can be deleted.
  avatar_url         String?
  avatar_storage_key String?

  status        AgentStatus @default(ACTIVE)
  /// Why the agent is SUSPENDED or REVOKED. Cleared on reactivation, so it
  /// always describes the current status.
  status_reason String?

  /// The admin who created the agent. A bare id, like `Profile.verified_by`:
  /// staff accounts are archived rather than deleted.
  created_by_user_id String    @db.Uuid
  last_login_at      DateTime?

  zones              AgentZone[]
  kyc_documents      AgentKycDocument[]
  ledger_entries     AgentLedgerEntry[]
  leads_claimed      AgentLead[]             @relation("AgentLeadClaimer")
  call_logs          AgentCallLog[]
  phone_reveals      AgentPhoneReveal[]
  applications       Application[]
  commissions        AgentCommission[]
  withdrawals        AgentWithdrawal[]
  notifications      AgentNotification[]
  push_subscriptions AgentPushSubscription[]

  @@unique([id_document_type, id_document_number], name: "idx_agent_id_document")
  @@index([status], name: "idx_agent_status")
  @@map("agents")
}

/// What an agent is told about. The copy is rendered once, in French, when the
/// row is written (agent-notification-catalog.ts).
enum AgentNotificationType {
  COMMISSION_EARNED
  COMMISSION_AVAILABLE
  COMMISSION_CANCELLED
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  PLACEMENT_ACCEPTED
  PLACEMENT_STARTED
  PLACEMENT_COMPLETED
  PLACEMENT_ENDED
  NEW_JOBS_IN_ZONE
  ZONES_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
}

/// The agent app's bell. Written by AgentNotificationService, which also
/// pushes it live (Redis → the agent's open SSE streams) and by Web Push.
model AgentNotification {
  id         String                @id @default(uuid()) @db.Uuid
  created_at DateTime              @default(now())
  agent_id   String                @db.Uuid
  type       AgentNotificationType
  title      String
  body       String
  /// In-app path the agent app opens on tap, without the host.
  link       String?
  metadata   Json?
  read_at    DateTime?
  /// One notification per business event: a retried sweep or a replayed
  /// outbox row hits this and is skipped.
  dedupe_key String?               @unique

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@index([agent_id, created_at(sort: Desc)], name: "idx_agent_notif_agent_time")
  @@index([agent_id, read_at], name: "idx_agent_notif_agent_unread")
  @@map("agent_notifications")
}

/// A browser or phone the agent allowed to receive Web Push. The endpoint is
/// the push service's URL for that installation; a 404/410 from it deletes
/// the row.
model AgentPushSubscription {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now())
  agent_id        String    @db.Uuid
  endpoint        String    @unique
  p256dh          String
  auth            String
  user_agent      String?
  last_success_at DateTime?

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@index([agent_id], name: "idx_agent_push_agent")
  @@map("agent_push_subscriptions")
}

/// The VAPID key pair Web Push messages are signed with, generated on first
/// use so no environment has to be configured. VAPID_PUBLIC_KEY and
/// VAPID_PRIVATE_KEY, when both set, take precedence. Changing the pair
/// invalidates every subscription (the app re-subscribes on its next visit).
model WebPushKeyPair {
  id          String   @id
  created_at  DateTime @default(now())
  public_key  String
  private_key String

  @@map("web_push_key_pairs")
}

/// Changes the agent app is notified about but that happen in many code
/// paths — a placed worker's application status, a job becoming open. Rows
/// are written by database triggers (see the migration), so no write site
/// can forget them, and consumed by AgentEventsConsumer.
model AgentEventOutbox {
  id           BigInt    @id @default(autoincrement())
  created_at   DateTime  @default(now())
  /// `placement_status` or `job_active`.
  kind         String
  entity_id    String    @db.Uuid
  payload      Json
  processed_at DateTime?

  @@index([processed_at, id], name: "idx_agent_event_outbox_pending")
  @@map("agent_event_outbox")
}

/// One city an agent covers. An agent sees only the jobs located in their
/// zones.
///
/// A city, in the canonical spelling `GeoService.canonicalCity` produces —
/// the same form `JobOffer.city` is written in, so the zone filter is an
/// equality rather than a fuzzy match.
model AgentZone {
  agent_id     String @db.Uuid
  country_code String @db.VarChar(2)
  city         String

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@id([agent_id, country_code, city])
  @@index([country_code, city], name: "idx_agent_zone_city")
  @@map("agent_zones")
}

/// An agent's identity documents, uploaded by the admin who created them.
///
/// Mirrors KycDocument: one row per category — DOCUMENT (front),
/// DOCUMENT_BACK, SELFIE — and a PASSPORT has no back. The document type is
/// the agent's own `id_document_type`, so it is not repeated per row.
///
/// The file lives ONLY in the private KYC bucket, under
/// `kyc-documents/agents/`, and is read back through the authenticated admin
/// stream route. No url is ever stored or issued.
/// Which part of an agent's money a ledger movement touches.
///
/// PENDING: earned, not yet withdrawable (confirmation window running).
/// AVAILABLE: withdrawable. LOCKED: held by a withdrawal request in progress.
/// PAID_OUT: transferred to the agent by an admin.
enum AgentLedgerBucket {
  PENDING
  AVAILABLE
  LOCKED
  PAID_OUT
}

/// Why a ledger movement happened. One business event can be several rows —
/// a release is −PENDING and +AVAILABLE — so the buckets always sum true.
enum AgentLedgerKind {
  COMMISSION_EARNED
  COMMISSION_RELEASED
  COMMISSION_CANCELLED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  /// The agent withdrew their own request before an admin decided.
  WITHDRAWAL_CANCELLED
  /// An admin correction, always with a note in `description`.
  ADJUSTMENT
}

/// An agent's money, as an append-only ledger.
///
/// Deliberately NOT the profile Wallet: that holds spending credit with a
/// mutable `balance` column and admin-deletable transactions. Here there is no
/// stored balance and no update or delete path — every balance is
/// SUM(amount) GROUP BY bucket over these rows, and a mistake is corrected by
/// an ADJUSTMENT row, never by editing history.
///
/// `idempotency_key` is unique, so replaying the job that wrote a movement
/// cannot write it twice.
model AgentLedgerEntry {
  id              String            @id @default(uuid()) @db.Uuid
  created_at      DateTime          @default(now())
  agent_id        String            @db.Uuid
  kind            AgentLedgerKind
  bucket          AgentLedgerBucket
  /// Signed, in FCFA: positive into the bucket, negative out of it.
  amount          Decimal           @db.Decimal(12, 2)
  /// What the movement is about: 'commission', 'withdrawal', 'adjustment'.
  reference_type  String
  reference_id    String?           @db.Uuid
  description     String?
  idempotency_key String            @unique

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Restrict)

  @@index([agent_id, bucket], name: "idx_agent_ledger_agent_bucket")
  @@index([agent_id, created_at(sort: Desc)], name: "idx_agent_ledger_agent_time")
  @@map("agent_ledger_entries")
}

enum AgentCommissionStatus {
  /// Earned; the confirmation window is running.
  PENDING
  /// Released to the agent's withdrawable balance.
  AVAILABLE
  /// Taken back: the mission was cancelled or a no-show, or an admin cancelled it.
  CANCELLED
  /// The placement did not qualify (see `reason`). No money moved.
  INELIGIBLE
}

/// One per placement an agent made: an application created from their
/// invitation whose contact unlock completed. Created by the commission sweep,
/// never by a request, so a retried payment cannot earn twice
/// (`application_id` is unique).
///
/// `application_id`, `contact_unlock_attempt_id`, `job_offer_id` and
/// `worker_id` carry no foreign key on purpose: like the ledger's
/// `reference_id`, a money record must outlive whatever it points at.
model AgentCommission {
  id                        String                @id @default(uuid()) @db.Uuid
  created_at                DateTime              @default(now())
  updated_at                DateTime              @updatedAt
  agent_id                  String                @db.Uuid
  application_id            String                @unique @db.Uuid
  contact_unlock_attempt_id String                @unique @db.Uuid
  job_offer_id              String                @db.Uuid
  worker_id                 String                @db.Uuid
  /// Snapshot of agent.commission_per_placement_fcfa when earned; 0 when INELIGIBLE.
  amount                    Decimal               @db.Decimal(10, 2)
  status                    AgentCommissionStatus @default(PENDING)
  /// When the money becomes withdrawable. Null while waiting for the mission
  /// to complete (release event COMPLETED).
  available_at              DateTime?             @db.Timestamptz
  released_at               DateTime?             @db.Timestamptz
  cancelled_at              DateTime?             @db.Timestamptz
  /// Why it is INELIGIBLE or CANCELLED.
  reason                    String?
  /// The agent.commission_* settings in force when it was decided.
  rules_snapshot            Json

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Restrict)

  @@index([status, available_at], name: "idx_agent_commission_status_available")
  @@index([agent_id, created_at(sort: Desc)], name: "idx_agent_commission_agent_time")
  @@map("agent_commissions")
}

enum AgentWithdrawalStatus {
  /// Asked for by the agent; the amount is locked until an admin decides.
  REQUESTED
  /// An admin sent the Mobile Money transfer and recorded its reference.
  PAID
  /// An admin refused it; the amount went back to the available balance.
  REJECTED
  /// The agent cancelled it while it was REQUESTED; the amount went back to
  /// the available balance.
  CANCELLED
}

/// Congo-Brazzaville's two Mobile Money networks.
enum AgentMomoOperator {
  MTN
  AIRTEL
}

/// An agent asking to be paid what they earned. Paid by hand: an admin sends
/// the Mobile Money transfer, then records its reference here. The money moves
/// in the ledger (AVAILABLE → LOCKED → PAID_OUT, or back to AVAILABLE).
///
/// At most one REQUESTED row per agent, enforced by the partial unique index
/// `agent_withdrawals_one_open` — raw SQL in 20261003140000_agent_withdrawals,
/// invisible to Prisma. Do not let a generated migration drop it.
model AgentWithdrawal {
  id                   String                @id @default(uuid()) @db.Uuid
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  agent_id             String                @db.Uuid
  amount               Decimal               @db.Decimal(10, 2)
  /// E.164. Defaults to the agent's own phone.
  momo_phone           String
  momo_operator        AgentMomoOperator
  status               AgentWithdrawalStatus @default(REQUESTED)
  processed_by_user_id String?               @db.Uuid
  processed_at         DateTime?             @db.Timestamptz
  /// The transfer's Mobile Money reference. Unique: one transfer cannot
  /// settle two withdrawals.
  provider_reference   String?               @unique
  rejection_reason     String?

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Restrict)

  @@index([status, created_at], name: "idx_agent_withdrawal_status_time")
  @@index([agent_id, created_at(sort: Desc)], name: "idx_agent_withdrawal_agent_time")
  @@map("agent_withdrawals")
}

/// Where one (job, worker) pair stands in an agent's pipeline.
enum AgentLeadStatus {
  /// Shown to agents as a candidate; nobody is working it.
  SUGGESTED
  /// An agent holds it until `claim_expires_at`; after that it is open again.
  CLAIMED
  /// The invitation link was issued; waiting on the worker.
  INVITED
  /// The worker accepted: the application exists (`application_id`).
  CONFIRMED
  /// The worker said no — on the phone or on the invitation.
  DECLINED
  /// Unreachable, or the number is wrong.
  UNREACHABLE
}

/// What a call to a worker came to.
enum AgentCallOutcome {
  INTERESTED
  NOT_AVAILABLE
  NOT_INTERESTED
  UNREACHABLE
  WRONG_NUMBER
  CALL_BACK
}

/// One worker suggested for one job, and the agent working it.
///
/// UNIQUE per (job, worker): at most one agent works a given worker for a given
/// job, and the first to claim it wins — which is what makes "which agent
/// placed this worker" unambiguous when the commission comes to be paid.
///
/// A claim is a lease, not ownership: once `claim_expires_at` passes without
/// an invitation, any agent covering the city may claim the lead.
model AgentLead {
  id                  String          @id @default(uuid()) @db.Uuid
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  job_offer_id        String          @db.Uuid
  worker_id           String          @db.Uuid
  status              AgentLeadStatus @default(SUGGESTED)
  claimed_by_agent_id String?         @db.Uuid
  claimed_at          DateTime?
  claim_expires_at    DateTime?
  /// 32 random bytes, base64url. The invitation link carries it; only the
  /// worker of this lead can redeem it.
  invite_token        String?         @unique
  invited_at          DateTime?
  invite_expires_at   DateTime?
  /// The application the worker created by accepting. Unique: one placement
  /// per lead.
  application_id      String?         @unique @db.Uuid
  decided_at          DateTime?

  job_offer   JobOffer           @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)
  worker      Profile            @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  claimed_by  Agent?             @relation("AgentLeadClaimer", fields: [claimed_by_agent_id], references: [id], onDelete: SetNull)
  application Application?       @relation(fields: [application_id], references: [id], onDelete: SetNull)
  calls       AgentCallLog[]
  reveals     AgentPhoneReveal[]

  @@unique([job_offer_id, worker_id], name: "idx_agent_lead_job_worker")
  @@index([claimed_by_agent_id, status], name: "idx_agent_lead_agent_status")
  @@index([job_offer_id, status], name: "idx_agent_lead_job_status")
  @@map("agent_leads")
}

/// One call an agent made about a lead. Append-only.
model AgentCallLog {
  id         String           @id @default(uuid()) @db.Uuid
  created_at DateTime         @default(now())
  lead_id    String           @db.Uuid
  agent_id   String           @db.Uuid
  outcome    AgentCallOutcome
  note       String?

  lead  AgentLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  agent Agent     @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@index([lead_id, created_at], name: "idx_agent_call_lead_time")
  @@index([agent_id, created_at], name: "idx_agent_call_agent_time")
  @@map("agent_call_logs")
}

/// One time an agent was shown a worker's phone number. Append-only; the
/// daily cap counts these rows, and support answers "who had my number" from
/// them.
model AgentPhoneReveal {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  agent_id   String   @db.Uuid
  lead_id    String   @db.Uuid
  worker_id  String   @db.Uuid
  ip_address String?

  agent  Agent     @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  lead   AgentLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  worker Profile   @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@index([agent_id, created_at], name: "idx_agent_reveal_agent_time")
  @@index([worker_id, created_at], name: "idx_agent_reveal_worker_time")
  @@map("agent_phone_reveals")
}

model AgentKycDocument {
  id                  String              @id @default(uuid()) @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  agent_id            String              @db.Uuid
  document_category   KycDocumentCategory
  storage_key         String
  uploaded_by_user_id String              @db.Uuid

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@unique([agent_id, document_category], name: "idx_agent_kyc_document_category")
  @@map("agent_kyc_documents")
}

model KycDocument {
  id                  String              @id @default(uuid()) @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  profile_id          String              @db.Uuid
  document_type       DocumentType?
  document_category   KycDocumentCategory
  document_url        String
  storage_key         String?
  verification_status VerificationStatus  @default(PENDING)
  verified_at         DateTime?
  verified_by         String?             @db.Uuid
  rejection_reason    String?

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, document_category], name: "idx_kyc_document_profile_category")
  @@index([profile_id], name: "idx_kyc_document_profile")
  @@index([verification_status], name: "idx_kyc_document_status")
  @@map("kyc_documents")
}

model KycVerificationImage {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  profile_id  String   @db.Uuid
  image_url   String
  /// Object key in the PRIVATE kyc bucket, so the image can be served through
  /// a time-limited signed url. Nullable because every row written before the
  /// bucket split has only `image_url`, pointing at the public bucket; the
  /// backfill fills these in.
  storage_key String?
  uploaded_by String?  @db.Uuid

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id], name: "idx_kyc_verification_image_profile")
  @@map("kyc_verification_images")
}

/// A worker's publication: text, images, or both.
///
/// There is no title. A publication used to require one, plus a description
/// and at least one photo — a portfolio entry, not a post. People publish the
/// way they do on social: a few words, a couple of photos, or just the photos.
/// The old titles were folded into `description` when the column was dropped,
/// so nothing anyone had written was lost.
///
/// "Text or images, at least one" cannot be expressed here — the images live
/// in another table — so that invariant is enforced in PortfolioService.
model PortfolioItem {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  profile_id  String   @db.Uuid
  /// Null for an images-only publication.
  description String?  @db.Text
  position    Int      @default(0)

  profile Profile          @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  images  PortfolioImage[]

  @@index([profile_id], name: "idx_portfolio_item_profile")
  @@map("portfolio_items")
}

model PortfolioImage {
  id                String   @id @default(uuid()) @db.Uuid
  created_at        DateTime @default(now())
  portfolio_item_id String   @db.Uuid
  image_url         String
  storage_key       String?
  position          Int      @default(0)

  item PortfolioItem @relation(fields: [portfolio_item_id], references: [id], onDelete: Cascade)

  @@index([portfolio_item_id], name: "idx_portfolio_image_item")
  @@map("portfolio_images")
}

model JobCategory {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?

  job_offers         JobOffer[]
  profiles           Profile[]
  profile_categories ProfileCategory[]

  @@index([slug], name: "idx_job_category_slug")
  @@map("job_categories")
}

model ProfileCategory {
  profile_id  String      @db.Uuid
  category_id String      @db.Uuid
  profile     Profile     @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  category    JobCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([profile_id, category_id])
  @@map("profile_categories")
}

// A worker's bookmarked job offers ("save for later").
model SavedJob {
  profile_id   String   @db.Uuid
  job_offer_id String   @db.Uuid
  created_at   DateTime @default(now())
  profile      Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  job_offer    JobOffer @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)

  @@id([profile_id, job_offer_id])
  @@index([profile_id], name: "idx_saved_job_profile")
  @@map("saved_jobs")
}

/**
 * Append-only behavioural log — the durable source of truth for recommendations.
 * Signals previously lived only in Qdrant, keyed `sha256(user__job__type)`, so a
 * second view OVERWROTE the first: interaction frequency and recency-of-Nth-view
 * were physically unrecoverable, and a Qdrant wipe erased all learned state with
 * no replay path. Postgres owns the history now; Qdrant and Redis hold only
 * derived, rebuildable projections.
 * Polymorphic on both ends because the subject can be a worker or an employer and
 * the object can be an offer, a profile, a portfolio or a search.
 */
model InteractionEvent {
  id          String            @id @default(uuid()) @db.Uuid
  occurred_at DateTime          @default(now()) @db.Timestamptz
  actor_id    String            @db.Uuid
  actor_type  InteractionActor
  kind        InteractionKind
  object_type InteractionObject
  /// Null for SEARCH (the query lives in metadata) and IMPRESSION_BATCH (ids do).
  object_id   String?           @db.Uuid

  /// Denormalised at write time so the aggregator never has to join back.
  category_id     String? @db.Uuid
  /// The offer's employer, or the viewed profile's owner — powers counterparty affinity.
  counterparty_id String? @db.Uuid

  /// Weight resolved at write time, kept for honest replay after retuning.
  weight  Float             @default(0)
  source  InteractionSource
  /// Which surface produced this — job_feed | job_search | worker_feed | detail | bot…
  surface String?           @db.VarChar(40)

  session_id String? @db.VarChar(64)
  /// Ties IMPRESSION_BATCH ⇄ VIEW ⇄ APPLY back to one ranked response, so CTR and
  /// position bias are computable.
  request_id String? @db.VarChar(64)
  position   Int?
  dwell_ms   Int?
  metadata   Json?

  actor Profile @relation("InteractionActor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([actor_id, occurred_at(sort: Desc)], name: "idx_ievent_actor_time")
  @@index([object_type, object_id, occurred_at(sort: Desc)], name: "idx_ievent_object_time")
  @@index([kind, occurred_at(sort: Desc)], name: "idx_ievent_kind_time")
  @@index([request_id], name: "idx_ievent_request")
  /// BRIN: the table is append-only and physically time-ordered, so this is a
  /// fraction of a btree's size and makes the retention prune cheap.
  @@index([occurred_at], name: "idx_ievent_occurred_brin", type: Brin)
  @@map("interaction_events")
}

/**
 * Derived per-profile preference features, rebuildable from InteractionEvent at
 * any time.
 * Lives in Postgres rather than Redis on purpose: the SQL-only fallback tier has
 * to read these when embeddings are disabled (`matching.use_embeddings` defaults
 * to false) or Qdrant is unavailable. That tier is what keeps two identical
 * profiles from getting identical feeds when the vector stack is off.
 */
model InteractionProfile {
  profile_id     String    @id @db.Uuid
  updated_at     DateTime  @updatedAt
  event_count    Int       @default(0)
  /// Drives the cold→warm→hot weight interpolation.
  positive_count Int       @default(0)
  last_event_at  DateTime?

  /// { categoryId: 0..1 }
  category_affinity     Json @default("{}")
  /// { employerId | workerId: 0..1 }
  counterparty_affinity Json @default("{}")
  /// { 'petit budget' | 'budget moyen' | 'budget élevé': 0..1 }
  amount_band_affinity  Json @default("{}")
  /// { HOURLY | DAILY | MONTHLY | TASK: 0..1 }
  payment_flow_affinity Json @default("{}")

  negative_category_ids String[] @db.Uuid
  /// Learned commute tolerance, replacing a global 5 km half-life for everyone.
  distance_half_life_km Float?

  vector_synced_at DateTime?

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([updated_at], name: "idx_iprofile_updated")
  @@map("interaction_profiles")
}

model JobOffer {
  id                      String         @id @default(uuid()) @db.Uuid
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  employer_id             String         @db.Uuid
  category_id             String?        @db.Uuid
  reference               String         @unique
  title                   String
  description             String         @db.Text
  employment_type         EmploymentType @default(MISSION)
  /// When the offer CLOSES — the point after which it stops accepting
  /// applications. Shown as «Date de clôture».
  ///
  /// Null only for CDI/CDD/STAGE: a permanent role has no single hour, while a
  /// MISSION still requires one. Null means the offer never expires on a date,
  /// so `expireEmptyOverdueOffers` falls back to created_at + 30 days — without
  /// that it would sit ACTIVE forever, since expiry is the only thing that ever
  /// retires an offer.
  ///
  /// The column keeps its old name while the meaning has moved; renaming it to
  /// `closes_at` touches ~50 call sites and is deliberately a separate change.
  scheduled_at            DateTime?
  amount                  Decimal?       @db.Decimal(10, 2)
  payment_flow            PaymentFlow?
  /// Null for a remote job, which has no site to travel to. Everything that
  /// renders it must handle that rather than printing an empty line.
  address                 String?
  /// A job done from anywhere. Suppresses the whole location block in the UI
  /// and removes distance from its ranking entirely.
  is_remote               Boolean        @default(false)
  /// ISO 3166-1 alpha-2. Set from the employer's own location at creation
  /// unless the offer declares its own — a job is usually, but not always,
  /// where the person posting it is.
  country_code            String?        @db.VarChar(2)
  country_name            String?
  city                    String?
  latitude                Float?
  longitude               Float?
  note                    String?
  quantity                Int            @default(1)
  status                  JobOfferStatus @default(ACTIVE)
  /// Shown before other offers until then: the employer's business plan
  /// includes priority visibility (set on activation, cleared on expiry).
  priority_until          DateTime?      @db.Timestamptz
  employer_unlock_paid    Boolean        @default(false)
  employer_unlock_paid_at DateTime?
  vector_indexed_at       DateTime?

  employer                Profile                @relation(fields: [employer_id], references: [id], onDelete: Cascade)
  category                JobCategory?           @relation(fields: [category_id], references: [id], onDelete: SetNull)
  applications            Application[]
  assignments             Assignment[]
  contact_unlock_attempts ContactUnlockAttempt[]
  contact_records         ContactRecord[]
  saved_by                SavedJob[]
  agent_leads             AgentLead[]
  cv_screenings           CvScreening[]
  interviews              Interview[]
  deleted_at              DateTime?              @db.Timestamptz

  @@index([employer_id], name: "idx_job_offer_employer")
  @@index([status], name: "idx_job_offer_status")
  @@index([scheduled_at], name: "idx_job_offer_scheduled")
  @@index([category_id], name: "idx_job_offer_category")
  @@index([deleted_at], name: "idx_job_offer_deleted_at")
  @@index([country_code, city], name: "idx_job_offer_country_city")
  @@map("job_offers")
}

model Application {
  id                  String                  @id @default(uuid()) @db.Uuid
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  job_offer_id        String                  @db.Uuid
  worker_id           String                  @db.Uuid
  status              ApplicationStatus       @default(PENDING)
  cancelled_at        DateTime?
  cancellation_reason String?
  /// Who cancelled, and therefore whether the worker may apply again: only a
  /// worker's own cancellation bars them.
  ///
  /// NULL means UNKNOWN, not "nobody", and unknown deliberately FAILS OPEN. Rows
  /// cancelled before this column existed cannot be classified: the ghost-cancel
  /// bug (fixed in #709) wrote innocent free-text replies through
  /// `ApplicationService.cancel()` itself, so they are indistinguishable from a
  /// deliberate cancellation. Failing closed would permanently bar exactly the
  /// people that fix was merged to unbar.
  cancelled_by        ApplicationCancelledBy?
  penalty_applied     Boolean                 @default(false)
  penalty_amount      Decimal?                @db.Decimal(10, 2)
  /// The status a WORKER cancellation left. Every one counts toward the
  /// repeated-cancellation suspension; only one from an accepted / paying /
  /// hired status also costs reliability points (COMMITTED_CANCEL_STATUSES).
  /// NULL for every other cancellation, and for those before the column.
  cancelled_from_status ApplicationStatus?

  /// Set when an employer accepts. `updated_at` is overwritten by every later
  /// transition, so it can't stand in for the decision moment.
  accepted_at      DateTime?
  rejected_at      DateTime?
  /// The employer's words with a refusal, shown to the candidate (no contact details).
  rejection_message String?          @db.Text
  /// EMPLOYER (an actual decision) vs AUTO_FILL (offer filled, pending closed out).
  /// Only EMPLOYER may be treated as a negative preference signal.
  rejection_source RejectionSource?

  viewed_at DateTime?

  job_offer              JobOffer              @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)
  worker                 Profile               @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  penalties              Penalty[]
  assignment             Assignment?
  contact_unlock_attempt ContactUnlockAttempt?
  contract               Contract?
  /// The field agent who brought this worker, when the application came from
  /// an agent invitation. Null for every application a worker made alone.
  agent_id               String?               @db.Uuid
  agent                  Agent?                @relation(fields: [agent_id], references: [id], onDelete: SetNull)
  agent_lead             AgentLead?
  /// Threads that last showed this application as their context. Plural since
  /// conversations became one per pair: the key is the pair, not this row.
  conversations          ProfileConversation[]
  interviews             Interview[]
  deleted_at             DateTime?             @db.Timestamptz

  /// NOT unique any more. Uniqueness is enforced by a PARTIAL index created in
  /// raw SQL — `applications_live_unique`, on (job_offer_id, worker_id) WHERE
  /// status <> 'CANCELLED' — so one live application per pair coexists with as
  /// many cancelled ones as history produced.
  ///
  /// Prisma cannot express a partial index, so it lives only in the migration.
  /// A future `migrate dev` will therefore report drift and offer to drop it:
  /// SAY NO, and carry the index forward by hand.
  @@index([job_offer_id, worker_id], name: "idx_application_pair")
  @@index([worker_id], name: "idx_application_worker")
  @@index([job_offer_id], name: "idx_application_job_offer")
  @@index([status], name: "idx_application_status")
  @@index([job_offer_id, status], name: "idx_application_job_offer_status")
  @@index([deleted_at], name: "idx_application_deleted_at")
  /// A worker's recent cancellations: the suspension count and the
  /// candidate↔employer compatibility penalty both read this.
  @@index([worker_id, cancelled_by, cancelled_at], name: "idx_application_worker_cancellations")
  @@map("applications")
  assessment ApplicationAssessment?
}

