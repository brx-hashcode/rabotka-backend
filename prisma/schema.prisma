/// One parrainage relationship: who invited whom, and what came of it.
///
/// The row is created at signup and pays nothing. Settlement happens later,
/// when the referee makes their first mobile-money payment for a connection —
/// see ReferralService.settleForReferee. `status` is the idempotency target for
/// that payout, the way `whatsapp_activation_bonus_granted` is for the welcome
/// credit: a conditional updateMany claims it, and a second caller finds
/// nothing to claim.
model Referral {
  id          String         @id @default(uuid()) @db.Uuid
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  referrer_id String         @db.Uuid
  /// UNIQUE: a profile is referred at most once, ever, and only at signup.
  /// This is what makes "who referred X" unambiguous at the database level
  /// rather than by convention, and it removes the need for a `referred_by_id`
  /// column on Profile that could drift from it.
  referee_id  String         @unique @db.Uuid
  /// The code as it was actually typed or followed, snapshotted. Codes are
  /// stable today; the admin answer to "where did this signup come from" must
  /// not depend on that staying true.
  code_used   String
  source      ReferralSource @default(LINK)
  status      ReferralStatus @default(PENDING)

  /// The payment that triggered settlement. NULL until the referee pays.
  /// UNIQUE so one payment can never settle two referrals.
  qualifying_payment_request_id String?   @unique @db.Uuid
  rewarded_at                   DateTime?
  /// What each side actually received. Written at settle time rather than read
  /// back from config, so changing the fees later never rewrites history.
  referrer_amount               Decimal?  @db.Decimal(10, 2)
  referee_amount                Decimal?  @db.Decimal(10, 2)
  /// Why nothing was paid. Set on CAPPED / FORFEITED / QUALIFIED_ON_HOLD, and
  /// the only thing that can answer a support question about a missing credit.
  settlement_note               String?

  deleted_at DateTime? @db.Timestamptz

  referrer           Profile         @relation("ReferralReferrer", fields: [referrer_id], references: [id], onDelete: Cascade)
  referee            Profile         @relation("ReferralReferee", fields: [referee_id], references: [id], onDelete: Cascade)
  qualifying_payment PaymentRequest? @relation(fields: [qualifying_payment_request_id], references: [id], onDelete: SetNull)

  @@index([referrer_id, status], name: "idx_referral_referrer_status")
  @@index([status], name: "idx_referral_status")
  @@index([created_at], name: "idx_referral_created_at")
  @@index([deleted_at], name: "idx_referral_deleted_at")
  @@map("referrals")
}

