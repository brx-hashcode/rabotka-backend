  @@index([profile_id], name: "idx_message_profile")
  @@index([created_at], name: "idx_message_created_at")
  // Serves the 24h WhatsApp service-window lookup (newest INBOUND per profile),
  // which runs on every admin send and every composer render.
  @@index([profile_id, direction, created_at(sort: Desc)], name: "idx_message_profile_direction_created")
  @@map("messages")
}

/// What VoVa knows about someone across conversations.
///
/// The transcript already lives in `messages`, but reading it back is not
/// memory: the assistant answers under a wall-clock budget, and its working
/// history is capped at six turns inside a four-hour window. Anything said
/// before that is gone — someone who spent four messages last week explaining
/// they only work weekends had to explain it again.
///
/// So this holds FACTS, not conversations: a short, rewritten-in-place list of
/// what stays true about the person. One indexed read by primary key puts it in
/// the prompt; the transcript is never re-read on the reply path.
///
/// Deliberately small. Every fact is a token spent on every later turn, and on
/// WhatsApp those tokens are latency — the same reason the history is six turns
/// and not sixty. The rebuild replaces the list rather than appending to it, so
/// it cannot creep.
model VovaProfileMemory {
  profile_id String   @id @db.Uuid
  /// `{ text, at }[]` — `at` is what lets a stale fact be dropped rather than
  /// asserted forever. Someone who looked for cleaning work in March is not
  /// still looking for it in September, and a confident wrong answer is worse
  /// than no memory at all.
  facts      Json     @default("[]")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@map("vova_profile_memory")
}

/// The delivery record for one WhatsApp send.
///
/// Deliberately NOT `Message`. That table is the profile CHAT transcript: it
/// requires a `profile_id`, so an OTP to a number that never registered has
/// nowhere to go, and it stores a template as the literal body `[TPL:kyc]` with
/// no id, status or recipient. This one exists to answer "did it arrive?", so
/// the recipient is a phone number, the profile is optional, and the row is
/// written BEFORE the provider call — its `id` rides to Meta as
/// `biz_opaque_callback_data` and comes back on the status webhook, which is
/// what correlates a delivery receipt to a send without a provider lookup.
model WhatsappMessage {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  provider            String // cloud | twilio
  /// Meta wamid (`wamid.…`) or Twilio SID (`SM…`/`MM…`). Null until the
  /// provider answers — and permanently null when the send failed outright.
  provider_message_id String? @unique

  direction  MessageDirection @default(OUTBOUND)
  /// E.164 with the leading `+`, matching the codebase's canonical phone form.
  /// For an INBOUND row this is the SENDER — the column keeps its name because
  /// it is the one phone the row is about either way.
  to_phone   String
  /// Optional: sends to unregistered numbers (OTP, activation) have no profile.
  profile_id String?          @db.Uuid

  kind              String // text | template | media | flow | interactive
  template_key      String?
  template_category String? // UTILITY | MARKETING | AUTHENTICATION
  /// Rendered text, or the resolved template body. Truncated at write time.
  body_preview      String
  variables         Json?

  status       WhatsappDeliveryStatus @default(QUEUED)
  sent_at      DateTime?
  delivered_at DateTime?
  read_at      DateTime?
  failed_at    DateTime?

  error_code          String?
  error_provider_code Int?
  error_message       String?

  /// From the webhook's `statuses[].pricing`. Meta only sends it once the
  /// message is billable, so it arrives with `delivered`, not with `sent`.
  pricing_category String?
  billable         Boolean?

  /// Set when an admin composed the message by hand.
  sent_by_id String? @db.Uuid

  /// INBOUND only: the sender's WhatsApp display name as it was when they
  /// wrote. The only name we have for someone who never registered.
  wa_profile_name String?
  /// INBOUND only: when the provider says the message was sent to us.
  received_at     DateTime?

  profile Profile? @relation(fields: [profile_id], references: [id], onDelete: SetNull)
  sent_by User?    @relation(fields: [sent_by_id], references: [id], onDelete: SetNull)

  @@index([created_at(sort: Desc)], name: "idx_wa_msg_created")
  @@index([status, created_at(sort: Desc)], name: "idx_wa_msg_status_created")
  @@index([template_key, created_at(sort: Desc)], name: "idx_wa_msg_template_created")
  @@index([to_phone], name: "idx_wa_msg_phone")
  @@index([profile_id], name: "idx_wa_msg_profile")
  @@index([direction, created_at(sort: Desc)], name: "idx_wa_msg_direction_created")
  @@map("whatsapp_messages")
}

/// Everyone who has ever written to us on WhatsApp, keyed by phone.
///
/// `whatsapp_messages` rows are purged after 180 days and a stranger has no
/// profile, so without this the only trace of a lead who never registered —
/// their number and the name they chose on WhatsApp — would expire with the
/// log. Never purged.
model WhatsappContact {
  id              String   @id @default(uuid()) @db.Uuid
  /// E.164 with the leading `+`.
  phone           String   @unique
  /// Latest WhatsApp display name seen. Never cleared by an event without one.
  wa_profile_name String?
  profile_id      String?  @db.Uuid
  first_seen_at   DateTime
  last_seen_at    DateTime
  inbound_count   Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  profile Profile? @relation(fields: [profile_id], references: [id], onDelete: SetNull)

  @@index([last_seen_at(sort: Desc)], name: "idx_wa_contact_last_seen")
  @@index([profile_id], name: "idx_wa_contact_profile")
  @@map("whatsapp_contacts")
}

