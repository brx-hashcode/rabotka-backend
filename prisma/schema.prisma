/// What a ProfileNotification is about. The client picks its icon from this, so
/// a new kind needs a client release to render as anything but the fallback.
enum ProfileNotificationType {
  // Worker
  PROFILE_VIEW
  JOB_RECOMMENDATION
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  HIRE_CANCELLED
  MISSION_RATED
  /// The employer changed the pay, date or place of an offer the worker is on.
  JOB_OFFER_UPDATED
  // Employer
  NEW_APPLICATION
  APPLICATION_CANCELLED
  MISSION_COMPLETED
  // Both
  CONTACT_UNLOCKED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  CLAIM_COMMENTED
  CLAIM_STATUS_CHANGED
  /// Somebody wrote in the in-app messaging.
  ///
  /// COLLAPSED PER CONVERSATION, not one per message. The bell is a feed of
  /// things that happened, and a chat produces dozens of those an hour — the
  /// trigger site passes a dedupe key on the conversation with a TTL, so a
  /// burst of ten messages leaves one row. Without that this type would make
  /// every other notification unreadable.
  NEW_MESSAGE
  /// An admin's announcement, sent to a segment rather than triggered by
  /// something that happened to this person. The only type a user can opt out
  /// of — see `Profile.marketing_opt_out_at`.
  ANNOUNCEMENT
  /// « Des profils comme le vôtre sont recrutés »: a worker similar to this
  /// one was just hired, and here is the one step that would raise this
  /// profile. Anonymous, at most once a week (SimilarHireNudgeService).
  SIMILAR_PROFILE_HIRED
  // Moved off WhatsApp: news the app now carries on its own.
  MISSION_REMINDER
  MISSION_STARTED
  MISSION_STATUS_CHECK
  JOB_OFFER_EXPIRED
  KYC_REJECTED
  ACCOUNT_SUSPENDED
  UNLOCK_CONVERTED_TO_CREDIT
  /// The business review's decisions (business accounts: email + in-app only).
  BUSINESS_VERIFIED
  BUSINESS_REJECTED
  /// One business paper refused on its own: replace it from the dashboard.
  BUSINESS_DOCUMENT_REJECTED
  /// Business subscriptions (email + in-app only).
  BUSINESS_TRIAL_STARTED
  BUSINESS_SUBSCRIPTION_ACTIVE
  BUSINESS_SUBSCRIPTION_EXPIRING
  BUSINESS_SUBSCRIPTION_EXPIRED
  /// A business asked a worker from its talent pool to apply to one of its offers.
  JOB_INVITATION
  CV_SCREENING_DONE
  INTERVIEW_INVITED
  INTERVIEW_CANCELLED
  INTERVIEW_ANSWERED
}

/// The in-app feed behind the bell in rabotka-client.
///
/// Per recipient, unlike AdminNotification, which every admin shares. The copy
/// is rendered at write time and stored, so a feed row reads the same after
/// the category or city it mentions is renamed.
model ProfileNotification {
  id           String                  @id @default(uuid()) @db.Uuid
  created_at   DateTime                @default(now())
  recipient_id String                  @db.Uuid
  type         ProfileNotificationType
  title        String
  body         String
  /// In-app path the client opens on tap, without the host. Null = no target.
  link         String?
  /// Who caused it. Kept for admin and abuse review and NEVER sent to the
  /// recipient: a profile view is shown anonymised, because naming the employer
  /// would give away what the contact unlock is paid for.
  actor_id     String?                 @db.Uuid
  /// Render inputs (sector, city, …) for clients that want more than the copy.
  metadata     Json?
  read_at      DateTime?
  /// Cleared from the profile's feed (swipe or « Tout effacer »). Kept rather
  /// than deleted so admin still sees the full history.
  dismissed_at DateTime?

  recipient Profile  @relation("ProfileNotificationRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  actor     Profile? @relation("ProfileNotificationActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([recipient_id, created_at(sort: Desc)], name: "idx_profile_notif_recipient_time")
  @@index([recipient_id, type, read_at], name: "idx_profile_notif_recipient_unread")
  @@map("profile_notifications")
}

/// One browser install that receives the profile's in-app notifications by Web
