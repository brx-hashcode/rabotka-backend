generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProfileType {
  WORKER
  EMPLOYER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UserRole {
  ADMIN
  MANAGER
  MODERATOR
  SUPER_ADMIN
}

enum StorageProvider {
  S3
  LOCAL
  CLOUDINARY
  VERCEL_BLOB
  CLOUDFLARE
}

enum BotPlatform {
  WHATSAPP
  EMAIL
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
  ALL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  BANNED
}

enum DocumentType {
  IDENTITY_CARD
  PASSPORT
  DRIVER_LICENSE
  BIRTH_CERTIFICATE
  STUDENT_CARD
  NIU_CARD
  OTHER
}

enum KycDocumentCategory {
  DOCUMENT
  SELFIE
}

enum JobOfferStatus {
  ACTIVE
  PARTIALLY_FILLED
  FILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  VIEWED
  WAITING_PAYMENT
  ACCEPTED
  REJECTED
  CANCELLED
  STARTED
  END
}

enum BillingStatus {
  CLEAR
  PENDING_PAYMENT
  BLOCKED
}

enum AssignmentStatus {
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED_BY_WORKER
  CANCELLED_BY_EMPLOYER
}

enum CancelledBy {
  WORKER
  EMPLOYER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  WALLET
  OTHER
}

enum PaymentType {
  REGISTRATION
  JOB_POSTING
  PENALTY
  CONTACT_UNLOCK
  WALLET_TOP_UP
}

enum PaymentFlow {
  HOURLY
  DAILY
  MONTHLY
}

enum WalletOwnerType {
  SYSTEM
  USER
  PROFILE
  MOBILE_MONEY
}

enum WalletTransactionType {
  CREDIT_PENALTY
  CREDIT_COMMISSION
  CREDIT_REGISTRATION
  CREDIT_JOB_POSTING
  WELCOME_CREDIT
  MANUAL_CREDIT
  CONTACT_UNLOCK_DEBIT
  CONTACT_UNLOCK_PAYMENT
  CONTACT_UNLOCK_CREDIT_CONVERSION
  PENALTY_DEBIT
  MOBILE_MONEY_CREDIT
  MOBILE_MONEY_WITHDRAWAL
  TOP_UP_CREDIT
}

enum ContactUnlockStatus {
  PENDING_BOTH
  PENDING_EMPLOYER
  PENDING_WORKER
  UNLOCKED
  EXPIRED
  CONVERTED_TO_CREDIT
}

enum PaymentRequestStatus {
  PENDING
  PROCESSING
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentRequestType {
  PENALTY_BATCH
  PENALTY_RESOLUTION
  CONTACT_UNLOCK
  RECOMMENDATION_CONTACT
  WALLET_TOP_UP
}

enum ClaimStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ConfigCategory {
  TWILIO
  FEES
  MATCHING
  CONTACT
  STORAGE
  GENERAL
}

enum InteractionActor {
  WORKER
  EMPLOYER
}

enum InteractionObject {
  JOB_OFFER
  WORKER_PROFILE
  EMPLOYER_PROFILE
  PORTFOLIO
  SEARCH
  CATEGORY
}

enum InteractionSource {
  WEB
  BOT
  MOBILE
  SERVER
  BACKFILL
}

enum InteractionKind {
  // Passive / browsing
  IMPRESSION_BATCH
  VIEW
  PROFILE_VIEW
  PORTFOLIO_VIEW
  // Explicit intent
  SEARCH
  SEARCH_CLICK
  SAVE
  UNSAVE
  // Commitment
  APPLY
  APPLY_CANCEL
  ACCEPT
  REJECT
  COMPLETE
  NO_SHOW
  // Outcome quality
  RATE_POSITIVE
  RATE_NEGATIVE
  // Paid intent — the strongest employer signal there is
  CONTACT_UNLOCK
  CONTACT_PAID
  // Explicit negatives
  SKIP
  DISLIKE
  // Bookkeeping for evaluation (what we served, so CTR is computable)
  RECOMMENDATION_SERVED
}

/**
 * How an employer's REJECTED decision came about.
 *
 * Without this, a bulk auto-reject (offer filled up, so everyone still pending is
 * closed out) is indistinguishable from an employer actively turning someone
 * down. The recommender reads repeated rejections in a category as "this worker
 * doesn't want this kind of work" — so losing two races would ban a worker from
 * their own trade. Only EMPLOYER rejections may count as a negative signal.
 */
enum RejectionSource {
  EMPLOYER
  AUTO_FILL
}

/** Which way a rating points. Previously only derivable by joining assignments. */
enum RatingDirection {
  EMPLOYER_TO_WORKER
  WORKER_TO_EMPLOYER
}

model SystemConfig {
  id         String         @id @default(uuid()) @db.Uuid
  key        String         @unique
  value      String         @db.Text
  category   ConfigCategory
  label      String
  is_secret  Boolean        @default(false)
  updated_at DateTime       @updatedAt
  updated_by String?        @db.Uuid

  @@index([category], name: "idx_system_config_category")
  @@map("system_configs")
}

model Profile {
  id                                String             @id @default(uuid()) @db.Uuid
  created_at                        DateTime           @default(now())
  updated_at                        DateTime           @updatedAt
  first_name                        String
  last_name                         String
  phone                             String             @unique
  email                             String             @unique
  address                           String
  latitude                          Float?
  longitude                         Float?
  description                       String             @db.Text
  profile_type                      ProfileType
  category_id                       String?            @db.Uuid
  status                            AccountStatus      @default(PENDING_ACTIVATION)
  billing_status                    BillingStatus      @default(CLEAR)
  reliability_score                 Int?               @default(100)
  rating_avg                        Float?
  rating_count                      Int                @default(0)
  whatsapp_connected                Boolean            @default(false)
  whatsapp_activation_bonus_granted Boolean            @default(false)
  payment_link                      String?
  payment_link_expires_at           DateTime?
  verification_status               VerificationStatus @default(PENDING)
  verified_by                       String?            @db.Uuid
  verified_at                       DateTime?
  rejection_reason                  String?
  /// Admin note from the latest KYC verify action (approve or reject).
  kyc_verification_note             String?            @db.Text
  read_and_approved_policies        Boolean            @default(false)
  first_login                       Boolean            @default(true)

  avatar_url        String?
  vector_indexed_at DateTime?
  portfolio_slug    String?   @unique

  category   JobCategory?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  categories ProfileCategory[]

  payment_requests                PaymentRequest[]
  kyc_documents                   KycDocument[]
  kyc_verification_images         KycVerificationImage[]
  applications                    Application[]
  job_offers                      JobOffer[]
  penalties                       Penalty[]
  payments                        Payment[]
  conversations                   Conversation[]
  messages                        Message[]
  logs                            Log[]
  files                           File[]
  wallets                         Wallet[]
  assignments                     Assignment[]
  verification_tokens             VerificationToken[]
  claims                          Claim[]                       @relation("ClaimProfile")
  unlock_attempts_as_worker       ContactUnlockAttempt[]        @relation("UnlockWorker")
  unlock_attempts_as_employer     ContactUnlockAttempt[]        @relation("UnlockEmployer")
  claims_created                  Claim[]                       @relation("ClaimCreatedByProfile")
  claim_comments                  ClaimComment[]                @relation("ClaimCommentProfile")
  events                          Event[]                       @relation("EventProfiles")
  profile_platform_document_links ProfilePlatformDocumentLink[]
  invoices                        Invoice[]
  ad_delivery_logs                AdDeliveryLog[]
  ratings_given                   Rating[]                      @relation("RatingRater")
  ratings_received                Rating[]                      @relation("RatingRatee")
  portfolio_items                 PortfolioItem[]
  saved_jobs                      SavedJob[]
  interaction_events              InteractionEvent[]            @relation("InteractionActor")
  interaction_profile             InteractionProfile?
  deleted_at                      DateTime?                     @db.Timestamptz

  @@index([email], name: "idx_profile_email")
  @@index([phone], name: "idx_profile_phone")
  @@index([status], name: "idx_profile_status")
  @@index([profile_type], name: "idx_profile_type")
  @@index([reliability_score], name: "idx_profile_reliability")
  @@index([category_id], name: "idx_profile_category")
  @@index([deleted_at], name: "idx_profile_deleted_at")
  @@map("profiles")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  first_name      String
  last_name       String
  email           String    @unique
  role            UserRole  @default(ADMIN)
  is_active       Boolean   @default(true)
  last_login_at   DateTime?
  phone_paired_at DateTime?
  phone_name      String?
  totp_secret     String?
  totp_enabled    Boolean   @default(false)

  files           File[]
  logs            Log[]
  wallets         Wallet[]
  sent_messages   Message[]
  claims_assigned Claim[]        @relation("ClaimAssignedUser")
  claims_created  Claim[]        @relation("ClaimCreatedByUser")
  claim_comments  ClaimComment[] @relation("ClaimCommentUser")
  events_created  Event[]        @relation("EventCreatedBy")
  events          Event[]        @relation("EventAssignedUsers")
  deleted_at      DateTime?      @db.Timestamptz

  chat_participants  ChatParticipant[]
  chat_messages      ChatMessage[]
  chat_conversations ChatConversation[] @relation("ChatConversationCreatedBy")

  @@index([email], name: "idx_user_email")
  @@index([role], name: "idx_user_role")
  @@index([deleted_at], name: "idx_user_deleted_at")
  @@map("users")
}

model KycDocument {
  id                  String              @id @default(uuid()) @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  profile_id          String              @db.Uuid
  document_type       DocumentType?
  document_category   KycDocumentCategory
  document_url        String
  storage_key         String?
  verification_status VerificationStatus  @default(PENDING)
  verified_at         DateTime?
  verified_by         String?             @db.Uuid
  rejection_reason    String?

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, document_category], name: "idx_kyc_document_profile_category")
  @@index([profile_id], name: "idx_kyc_document_profile")
  @@index([verification_status], name: "idx_kyc_document_status")
  @@map("kyc_documents")
}

model KycVerificationImage {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  profile_id  String   @db.Uuid
  image_url   String
  uploaded_by String?  @db.Uuid

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id], name: "idx_kyc_verification_image_profile")
  @@map("kyc_verification_images")
}

model PortfolioItem {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  profile_id  String   @db.Uuid
  title       String
  description String   @db.Text
  position    Int      @default(0)

  profile Profile          @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  images  PortfolioImage[]

  @@index([profile_id], name: "idx_portfolio_item_profile")
  @@map("portfolio_items")
}

model PortfolioImage {
  id                String   @id @default(uuid()) @db.Uuid
  created_at        DateTime @default(now())
  portfolio_item_id String   @db.Uuid
  image_url         String
  storage_key       String?
  position          Int      @default(0)

  item PortfolioItem @relation(fields: [portfolio_item_id], references: [id], onDelete: Cascade)

  @@index([portfolio_item_id], name: "idx_portfolio_image_item")
  @@map("portfolio_images")
}

model JobCategory {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?

  job_offers         JobOffer[]
  profiles           Profile[]
  profile_categories ProfileCategory[]

  @@index([slug], name: "idx_job_category_slug")
  @@map("job_categories")
}

model ProfileCategory {
  profile_id  String      @db.Uuid
  category_id String      @db.Uuid
  profile     Profile     @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  category    JobCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([profile_id, category_id])
  @@map("profile_categories")
}

// A worker's bookmarked job offers ("save for later").
model SavedJob {
  profile_id   String   @db.Uuid
  job_offer_id String   @db.Uuid
  created_at   DateTime @default(now())
  profile      Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  job_offer    JobOffer @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)

  @@id([profile_id, job_offer_id])
  @@index([profile_id], name: "idx_saved_job_profile")
  @@map("saved_jobs")
}

/**
 * Append-only behavioural log — the durable source of truth for recommendations.
 *
 * Signals previously lived only in Qdrant, keyed `sha256(user__job__type)`, so a
 * second view OVERWROTE the first: interaction frequency and recency-of-Nth-view
 * were physically unrecoverable, and a Qdrant wipe erased all learned state with
 * no replay path. Postgres owns the history now; Qdrant and Redis hold only
 * derived, rebuildable projections.
 *
 * Polymorphic on both ends because the subject can be a worker or an employer and
 * the object can be an offer, a profile, a portfolio or a search.
 */
model InteractionEvent {
  id          String            @id @default(uuid()) @db.Uuid
  occurred_at DateTime          @default(now()) @db.Timestamptz
  actor_id    String            @db.Uuid
  actor_type  InteractionActor
  kind        InteractionKind
  object_type InteractionObject
  /// Null for SEARCH (the query lives in metadata) and IMPRESSION_BATCH (ids do).
  object_id   String?           @db.Uuid

  /// Denormalised at write time so the aggregator never has to join back.
  category_id     String? @db.Uuid
  /// The offer's employer, or the viewed profile's owner — powers counterparty affinity.
  counterparty_id String? @db.Uuid

  /// Weight resolved at write time, kept for honest replay after retuning.
  weight  Float             @default(0)
  source  InteractionSource
  /// Which surface produced this — job_feed | job_search | worker_feed | detail | bot…
  surface String?           @db.VarChar(40)

  session_id String? @db.VarChar(64)
  /// Ties IMPRESSION_BATCH ⇄ VIEW ⇄ APPLY back to one ranked response, so CTR and
  /// position bias are computable.
  request_id String? @db.VarChar(64)
  position   Int?
  dwell_ms   Int?
  metadata   Json?

  actor Profile @relation("InteractionActor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([actor_id, occurred_at(sort: Desc)], name: "idx_ievent_actor_time")
  @@index([object_type, object_id, occurred_at(sort: Desc)], name: "idx_ievent_object_time")
  @@index([kind, occurred_at(sort: Desc)], name: "idx_ievent_kind_time")
  @@index([request_id], name: "idx_ievent_request")
  /// BRIN: the table is append-only and physically time-ordered, so this is a
  /// fraction of a btree's size and makes the retention prune cheap.
  @@index([occurred_at], name: "idx_ievent_occurred_brin", type: Brin)
  @@map("interaction_events")
}

/**
 * Derived per-profile preference features, rebuildable from InteractionEvent at
 * any time.
 *
 * Lives in Postgres rather than Redis on purpose: the SQL-only fallback tier has
 * to read these when embeddings are disabled (`matching.use_embeddings` defaults
 * to false) or Qdrant is unavailable. That tier is what keeps two identical
 * profiles from getting identical feeds when the vector stack is off.
 */
model InteractionProfile {
  profile_id  String   @id @db.Uuid
  updated_at  DateTime @updatedAt
  event_count Int      @default(0)
  /// Drives the cold→warm→hot weight interpolation.
  positive_count Int   @default(0)
  last_event_at  DateTime?

  /// { categoryId: 0..1 }
  category_affinity     Json @default("{}")
  /// { employerId | workerId: 0..1 }
  counterparty_affinity Json @default("{}")
  /// { 'petit budget' | 'budget moyen' | 'budget élevé': 0..1 }
  amount_band_affinity  Json @default("{}")
  /// { HOURLY | DAILY | MONTHLY: 0..1 }
  payment_flow_affinity Json @default("{}")

  negative_category_ids String[] @db.Uuid
  /// Learned commute tolerance, replacing a global 5 km half-life for everyone.
  distance_half_life_km Float?

  vector_synced_at DateTime?

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([updated_at], name: "idx_iprofile_updated")
  @@map("interaction_profiles")
}

model JobOffer {
  id                      String         @id @default(uuid()) @db.Uuid
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  employer_id             String         @db.Uuid
  category_id             String?        @db.Uuid
  reference               String         @unique
  title                   String
  description             String         @db.Text
  scheduled_at            DateTime
  amount                  Decimal?       @db.Decimal(10, 2)
  payment_flow            PaymentFlow?
  address                 String
  latitude                Float?
  longitude               Float?
  note                    String?
  quantity                Int            @default(1)
  status                  JobOfferStatus @default(ACTIVE)
  employer_unlock_paid    Boolean        @default(false)
  employer_unlock_paid_at DateTime?
  vector_indexed_at       DateTime?

  employer                Profile                @relation(fields: [employer_id], references: [id], onDelete: Cascade)
  category                JobCategory?           @relation(fields: [category_id], references: [id], onDelete: SetNull)
  applications            Application[]
  assignments             Assignment[]
  contact_unlock_attempts ContactUnlockAttempt[]
  saved_by                SavedJob[]
  deleted_at              DateTime?              @db.Timestamptz

  @@index([employer_id], name: "idx_job_offer_employer")
  @@index([status], name: "idx_job_offer_status")
  @@index([scheduled_at], name: "idx_job_offer_scheduled")
  @@index([category_id], name: "idx_job_offer_category")
  @@index([deleted_at], name: "idx_job_offer_deleted_at")
  @@map("job_offers")
}

model Application {
  id                  String            @id @default(uuid()) @db.Uuid
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  job_offer_id        String            @db.Uuid
  worker_id           String            @db.Uuid
  status              ApplicationStatus @default(PENDING)
  cancelled_at        DateTime?
  cancellation_reason String?
  penalty_applied     Boolean           @default(false)
  penalty_amount      Decimal?          @db.Decimal(10, 2)

  /// Set when an employer accepts. `updated_at` is overwritten by every later
  /// transition, so it can't stand in for the decision moment.
  accepted_at DateTime?
  rejected_at DateTime?
  /// EMPLOYER (an actual decision) vs AUTO_FILL (offer filled, pending closed out).
  /// Only EMPLOYER may be treated as a negative preference signal.
  rejection_source RejectionSource?

  viewed_at DateTime?

  job_offer              JobOffer              @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)
  worker                 Profile               @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  penalties              Penalty[]
  assignment             Assignment?
  contact_unlock_attempt ContactUnlockAttempt?
  contract               Contract?
  deleted_at             DateTime?             @db.Timestamptz

  @@unique([job_offer_id, worker_id], name: "idx_application_unique")
  @@index([worker_id], name: "idx_application_worker")
  @@index([job_offer_id], name: "idx_application_job_offer")
  @@index([status], name: "idx_application_status")
  @@index([job_offer_id, status], name: "idx_application_job_offer_status")
  @@index([deleted_at], name: "idx_application_deleted_at")
  @@map("applications")
}

model Assignment {
  id             String           @id @default(uuid()) @db.Uuid
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  application_id String           @unique @db.Uuid
  job_offer_id   String           @db.Uuid
  worker_id      String           @db.Uuid
  status         AssignmentStatus @default(CONFIRMED)
  cancelled_by   CancelledBy?
  cancelled_at   DateTime?
  completed_at   DateTime?
  no_show_at     DateTime?
  note           String?

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  job_offer   JobOffer    @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)
  worker      Profile     @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  ratings     Rating[]

  @@index([job_offer_id], name: "idx_assignment_job_offer")
  @@index([worker_id], name: "idx_assignment_worker")
  @@index([status], name: "idx_assignment_status")
  @@map("assignments")
}

model ContactUnlockAttempt {
  id               String              @id @default(uuid()) @db.Uuid
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  application_id   String              @unique @db.Uuid
  job_offer_id     String              @db.Uuid
  worker_id        String              @db.Uuid
  employer_id      String              @db.Uuid
  status           ContactUnlockStatus @default(PENDING_BOTH)
  employer_paid    Boolean             @default(false)
  worker_paid      Boolean             @default(false)
  employer_paid_at DateTime?
  worker_paid_at   DateTime?
  employer_amount  Decimal             @db.Decimal(10, 2)
  worker_amount    Decimal             @db.Decimal(10, 2)
  expires_at       DateTime
  unlocked_at      DateTime?
  converted_at     DateTime?

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  job_offer   JobOffer    @relation(fields: [job_offer_id], references: [id], onDelete: Cascade)
  worker      Profile     @relation("UnlockWorker", fields: [worker_id], references: [id], onDelete: Cascade)
  employer    Profile     @relation("UnlockEmployer", fields: [employer_id], references: [id], onDelete: Cascade)

  @@index([application_id], name: "idx_unlock_application")
  @@index([status], name: "idx_unlock_status")
  @@index([expires_at], name: "idx_unlock_expires_at")
  @@index([worker_id], name: "idx_unlock_worker")
  @@index([employer_id], name: "idx_unlock_employer")
  @@map("contact_unlock_attempts")
}

model Penalty {
  id                 String    @id @default(uuid()) @db.Uuid
  created_at         DateTime  @default(now())
  profile_id         String    @db.Uuid
  application_id     String?   @db.Uuid
  amount             Decimal   @db.Decimal(10, 2)
  reason             String?
  applied_at         DateTime  @default(now())
  paid_at            DateTime?
  notification_count Int       @default(0)
  last_notified_at   DateTime?

  profile     Profile      @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [application_id], references: [id], onDelete: Cascade)
  deleted_at  DateTime?    @db.Timestamptz

  @@unique([application_id], name: "idx_penalty_application_unique")
  @@index([profile_id], name: "idx_penalty_profile")
  @@index([applied_at], name: "idx_penalty_applied_at")
  @@index([deleted_at], name: "idx_penalty_deleted_at")
  @@map("penalties")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  type           PaymentType
  profile_id     String        @db.Uuid
  amount         Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod
  transaction_id String        @unique
  status         PaymentStatus @default(PENDING)
  paid_at        DateTime?
  description    String?

  profile Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  invoice Invoice?

  @@index([transaction_id], name: "idx_payment_transaction")
  @@index([status], name: "idx_payment_status")
  @@index([profile_id], name: "idx_payment_profile")
  @@index([type], name: "idx_payment_type")
  @@map("payments")
}

model Wallet {
  id         String          @id @default(uuid()) @db.Uuid
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  owner_type WalletOwnerType
  user_id    String?         @db.Uuid
  profile_id String?         @db.Uuid
  balance    Decimal         @default(0) @db.Decimal(12, 2)

  user         User?               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  profile      Profile?            @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@unique([owner_type, user_id], name: "idx_wallet_owner_user")
  @@unique([owner_type, profile_id], name: "idx_wallet_owner_profile")
  @@index([owner_type], name: "idx_wallet_owner_type")
  @@map("wallets")
}

model WalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  wallet_id      String                @db.Uuid
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(10, 2)
  reference_type String?
  reference_id   String?               @db.Uuid
  created_at     DateTime              @default(now())

  deleted_at DateTime? @db.Timestamptz

  wallet Wallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id], name: "idx_wallet_transaction_wallet")
  @@index([created_at], name: "idx_wallet_transaction_created_at")
  @@index([type], name: "idx_wallet_transaction_type")
  @@index([deleted_at], name: "idx_wallet_transaction_deleted_at")
  @@map("wallet_transactions")
}

model File {
  id                String          @id @default(uuid()) @db.Uuid
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  filename          String
  original_filename String
  mime_type         String
  size              Int
  storage_provider  StorageProvider
  storage_key       String
  bucket            String?
  profile_id        String?         @db.Uuid
  uploaded_by_id    String?         @db.Uuid

  profile     Profile? @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  uploaded_by User?    @relation(fields: [uploaded_by_id], references: [id], onDelete: Cascade)

  @@index([profile_id], name: "idx_file_profile")
  @@index([uploaded_by_id], name: "idx_file_uploaded_by")
  @@map("files")
}

model Log {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  action      String
  entity_type String?
  entity_id   String?
  user_id     String?  @db.Uuid
  profile_id  String?  @db.Uuid
  metadata    Json?
  ip_address  String?
  user_agent  String?

  user    User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_log_user")
  @@index([profile_id], name: "idx_log_profile")
  @@index([entity_type, entity_id], name: "idx_log_entity")
  @@map("logs")
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  profile_id     String             @db.Uuid
  bot_session_id String
  bot_platform   BotPlatform        @default(WHATSAPP)
  status         ConversationStatus @default(ACTIVE)
  started_at     DateTime
  ended_at       DateTime?

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, bot_session_id], name: "idx_conversation_unique")
  @@index([profile_id], name: "idx_conversation_profile")
  @@index([status], name: "idx_conversation_status")
  @@map("conversations")
}

model Message {
  id         String           @id @default(uuid()) @db.Uuid
  created_at DateTime         @default(now())
  profile_id String           @db.Uuid
  direction  MessageDirection
  platform   BotPlatform      @default(WHATSAPP)
  body       String
  sent_by_id String?          @db.Uuid

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  sent_by User?   @relation(fields: [sent_by_id], references: [id], onDelete: SetNull)

  @@index([profile_id], name: "idx_message_profile")
  @@index([created_at], name: "idx_message_created_at")
  @@map("messages")
}

model VerificationToken {
  id         String    @id @default(cuid())
  profile_id String    @db.Uuid
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  profile    Profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PaymentRequest {
  id                        String               @id @default(uuid()) @db.Uuid
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  profile_id                String               @db.Uuid
  token                     String               @unique
  status                    PaymentRequestStatus @default(PENDING)
  payment_reference         String?
  proof_images              String[]
  rejection_note            String?
  amount                    Decimal?             @db.Decimal(10, 2)
  description               String?
  phone                     String?
  operator                  String?
  gateway                   String?
  gateway_payment_ref       String?              @unique
  gateway_tx_id             String?
  monetbil_payment_ref      String?              @unique
  monetbil_tx_id            String?
  request_type              PaymentRequestType?
  recommendation_worker_id  String?              @db.Uuid
  contact_unlock_attempt_id String?              @db.Uuid

  profile    Profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  invoice    Invoice?
  deleted_at DateTime? @db.Timestamptz

  @@index([profile_id], name: "idx_payment_request_profile")
  @@index([token], name: "idx_payment_request_token")
  @@index([status], name: "idx_payment_request_status")
  @@index([monetbil_payment_ref], name: "idx_payment_request_monetbil_ref")
  @@index([request_type], name: "idx_payment_request_type")
  @@index([deleted_at], name: "idx_payment_request_deleted_at")
  @@map("payment_requests")
}

model Claim {
  id                    String      @id @default(uuid()) @db.Uuid
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  title                 String
  description           String      @db.Text
  status                ClaimStatus @default(CREATED)
  attachment_urls       String[]    @default([])
  profile_id            String      @db.Uuid
  assigned_user_id      String?     @db.Uuid
  created_by_user_id    String?     @db.Uuid
  created_by_profile_id String?     @db.Uuid

  profile            Profile        @relation("ClaimProfile", fields: [profile_id], references: [id], onDelete: Cascade)
  assigned_user      User?          @relation("ClaimAssignedUser", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  created_by_user    User?          @relation("ClaimCreatedByUser", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  created_by_profile Profile?       @relation("ClaimCreatedByProfile", fields: [created_by_profile_id], references: [id], onDelete: SetNull)
  comments           ClaimComment[]

  @@index([profile_id])
  @@index([status])
  @@index([assigned_user_id])
  @@map("claims")
}

model ClaimComment {
  id              String   @id @default(uuid()) @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  claim_id        String   @db.Uuid
  content         String   @db.Text
  user_id         String?  @db.Uuid
  profile_id      String?  @db.Uuid
  created_by_type String   @default("user")

  claim   Claim    @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  user    User?    @relation("ClaimCommentUser", fields: [user_id], references: [id], onDelete: SetNull)
  profile Profile? @relation("ClaimCommentProfile", fields: [profile_id], references: [id], onDelete: SetNull)

  @@index([claim_id])
  @@map("claim_comments")
}

model Event {
  id            Int             @id @default(autoincrement())
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  title         String
  description   String          @db.Text
  start_date    DateTime
  end_date      DateTime
  color         String
  channel       DeliveryChannel @default(EMAIL)
  location      String?
  created_by_id String          @db.Uuid

  created_by     User      @relation("EventCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  profiles       Profile[] @relation("EventProfiles")
  assigned_users User[]    @relation("EventAssignedUsers")

  @@index([created_by_id], name: "idx_event_created_by")
  @@index([start_date], name: "idx_event_start_date")
  @@map("events")
}

enum DocumentCategory {
  AGREEMENT
  CONTRACT
  POLICY
  INVOICE
  REPORT
  OTHER
}

enum DocumentSourceMode {
  UPLOAD
  GOOGLE_DOCS
}

model Document {
  id              String             @id @default(uuid()) @db.Uuid
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  title           String
  category        DocumentCategory
  file_url        String
  mime_type       String
  created_by      String?            @db.Uuid
  source_mode     DocumentSourceMode @default(UPLOAD)
  google_docs_id  String?
  google_docs_url String?
  preview_url     String?
  variables       String[]           @default([])

  profile_platform_document_links ProfilePlatformDocumentLink[]

  @@index([category], name: "idx_document_category")
  @@index([created_at], name: "idx_document_created_at")
  @@map("documents")
}

model ProfilePlatformDocumentLink {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  profile_id  String   @db.Uuid
  document_id String   @db.Uuid

  profile  Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, document_id])
  @@map("profile_platform_document_links")
}

model AdminNotification {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  event       String
  title       String
  message     String
  entity_type String
  entity_id   String
  metadata    Json?
  read        Boolean  @default(false)

  @@index([created_at], name: "idx_admin_notification_created_at")
  @@index([read], name: "idx_admin_notification_read")
  @@map("admin_notifications")
}

enum ContractStatus {
  PENDING_DOWNLOAD
  DOWNLOADED
}

model Contract {
  id               String         @id @default(uuid()) @db.Uuid
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  application_id   String         @unique @db.Uuid
  template_version Int            @default(1)
  status           ContractStatus @default(PENDING_DOWNLOAD)

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id], name: "idx_contract_application")
  @@map("contracts")
}

enum InvoiceStatus {
  PENDING_DOWNLOAD
  DOWNLOADED
}

enum InvoiceReason {
  CONTACT_UNLOCK
  PENALTY
  WALLET_TOP_UP
  OTHER
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  profile_id          String        @db.Uuid
  payment_request_id  String?       @unique @db.Uuid
  payment_id          String?       @unique @db.Uuid
  amount              Decimal       @db.Decimal(10, 2)
  reason              InvoiceReason @default(OTHER)
  related_entity_type String?
  related_entity_id   String?       @db.Uuid
  status              InvoiceStatus @default(PENDING_DOWNLOAD)

  profile         Profile         @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  payment_request PaymentRequest? @relation(fields: [payment_request_id], references: [id], onDelete: Cascade)
  payment         Payment?        @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([profile_id], name: "idx_invoice_profile")
  @@index([payment_request_id], name: "idx_invoice_payment_request")
  @@map("invoices")
}

// ─── Advertisement Module ────────────────────────────────────────────────────

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  CANCELLED
}

enum AdPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum AdvertiserType {
  COMPANY
  INDIVIDUAL
}

enum BundleTargetAudience {
  WORKER
  EMPLOYER
  BOTH
}

enum AdDeliveryStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  FAILED
}

model AdvertisementBundle {
  id                     String               @id @default(uuid()) @db.Uuid
  name                   String
  description            String               @db.Text
  price                  Decimal              @db.Decimal(10, 2)
  currency               String               @default("XAF")
  max_reach              Int
  max_frequency_per_week Int
  max_duration_days      Int
  allowed_channels       DeliveryChannel[]
  target_audience        BundleTargetAudience @default(BOTH)
  is_active              Boolean              @default(true)
  created_at             DateTime             @default(now())
  advertisements         Advertisement[]

  @@map("advertisement_bundles")
}

model Advertisement {
  id               String          @id @default(uuid()) @db.Uuid
  bundle_id        String          @db.Uuid
  title            String
  description      String          @db.Text
  call_to_action   String?
  cta_url          String?
  image_urls       String[]
  video_url        String?
  banner_url       String?
  logo_url         String?
  contact_phone    String?
  contact_email    String?
  sector           String?
  advertiser_type  AdvertiserType
  language         String          @default("fr")
  tags             String[]
  start_date       DateTime        @db.Date
  end_date         DateTime        @db.Date
  dispatch_time    String          @default("08:00")
  target_filters   Json?
  status           AdStatus        @default(DRAFT)
  rejection_reason String?
  payment_status   AdPaymentStatus @default(UNPAID)
  invoice_id       String?
  budget           Decimal?        @db.Decimal(10, 2)
  total_sent       Int             @default(0)
  total_opened     Int             @default(0)
  total_clicks     Int             @default(0)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  bundle        AdvertisementBundle @relation(fields: [bundle_id], references: [id])
  delivery_logs AdDeliveryLog[]
  tracked_links AdTrackedLink[]

  @@index([status], name: "idx_advertisement_status")
  @@index([bundle_id], name: "idx_advertisement_bundle")
  @@map("advertisements")
}

model AdDeliveryLog {
  id               String           @id @default(uuid()) @db.Uuid
  advertisement_id String           @db.Uuid
  profile_id       String           @db.Uuid
  channel          DeliveryChannel
  status           AdDeliveryStatus
  sent_at          DateTime?
  opened_at        DateTime?
  clicked_at       DateTime?
  failure_reason   String?

  advertisement Advertisement   @relation(fields: [advertisement_id], references: [id], onDelete: Cascade)
  profile       Profile         @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  tracked_links AdTrackedLink[]

  @@index([advertisement_id], name: "idx_ad_delivery_advertisement")
  @@index([profile_id], name: "idx_ad_delivery_profile")
  @@index([sent_at], name: "idx_ad_delivery_sent_at")
  @@index([advertisement_id, sent_at], name: "idx_ad_delivery_advertisement_sent_at")
  @@map("ad_delivery_logs")
}

model AdTrackedLink {
  id                 String          @id @default(uuid()) @db.Uuid
  hash               String          @unique
  advertisement_id   String          @db.Uuid
  ad_delivery_log_id String          @db.Uuid
  original_url       String
  channel            DeliveryChannel
  click_count        Int             @default(0)
  last_clicked_at    DateTime?
  last_click_ip      String?
  last_click_ua      String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  advertisement Advertisement @relation(fields: [advertisement_id], references: [id], onDelete: Cascade)
  delivery_log  AdDeliveryLog @relation(fields: [ad_delivery_log_id], references: [id], onDelete: Cascade)

  @@index([advertisement_id], name: "idx_ad_tracked_link_advertisement")
  @@index([ad_delivery_log_id], name: "idx_ad_tracked_link_delivery_log")
  @@map("ad_tracked_links")
}

model Rating {
  id            String   @id @default(uuid()) @db.Uuid
  created_at    DateTime @default(now())
  rater_id      String   @db.Uuid
  ratee_id      String   @db.Uuid
  assignment_id String   @db.Uuid
  score         Int
  /// Stored rather than re-derived: telling worker→employer from employer→worker
  /// otherwise needs a join through assignment → job_offer on every read.
  direction     RatingDirection?

  rater      Profile    @relation("RatingRater", fields: [rater_id], references: [id], onDelete: Cascade)
  ratee      Profile    @relation("RatingRatee", fields: [ratee_id], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@unique([rater_id, assignment_id])
  @@index([ratee_id], name: "idx_rating_ratee")
  @@map("ratings")
}

enum ChatConversationType {
  DIRECT
  GROUP
}

model ChatConversation {
  id         String               @id @default(uuid()) @db.Uuid
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  type       ChatConversationType
  name       String?
  is_team    Boolean              @default(false)
  created_by String?              @db.Uuid

  creator      User?             @relation("ChatConversationCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([updated_at], name: "idx_chat_conversation_updated")
  @@index([type], name: "idx_chat_conversation_type")
  @@index([is_team], name: "idx_chat_conversation_is_team")
  @@map("chat_conversations")
}

model ChatParticipant {
  id              String    @id @default(uuid()) @db.Uuid
  conversation_id String    @db.Uuid
  user_id         String    @db.Uuid
  joined_at       DateTime  @default(now())
  last_read_at    DateTime?

  conversation ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id], name: "idx_chat_participant_unique")
  @@index([user_id], name: "idx_chat_participant_user")
  @@index([conversation_id], name: "idx_chat_participant_conversation")
  @@map("chat_participants")
}

model ChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  conversation_id String    @db.Uuid
  sender_id       String    @db.Uuid
  body            String?   @db.Text
  attachments     Json?
  created_at      DateTime  @default(now())
  edited_at       DateTime?
  deleted_at      DateTime?

  conversation ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at], name: "idx_chat_message_conversation_created")
  @@index([sender_id], name: "idx_chat_message_sender")
  @@map("chat_messages")
}
